PREFIX fp: <urn:chatman:ferroplan:v26.8.1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?enum_order ?enum_name ?enum_comment ?variant_order ?variant_name ?serde_name ?rust_type
WHERE {
  ?enum a fp:RustEnum ;
        fp:rustName ?enum_name ;
        fp:order ?enum_order ;
        fp:hasVariant ?variant .
  OPTIONAL { ?enum rdfs:comment ?enum_comment }
  ?variant fp:rustName ?variant_name ;
           fp:serdeName ?serde_name ;
           fp:order ?variant_order .
  OPTIONAL { ?variant fp:rustType ?rust_type }
}
ORDER BY ?enum_order ?variant_order
