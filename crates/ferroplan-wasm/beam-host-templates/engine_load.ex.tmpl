---
to: generated/beam-host/engine_load.ex
sparql:
  profile: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?app ?root ?task_root ?prefix ?abi_version ?free_symbol ?len_type ?alloc_zero_policy ?out_mode
           ?req_consumed ?pin_format ?path_env ?handle_noun ?taxonomy_ns ?refusal_module ?request_cap
           ?manifest_rel ?wasm_rel ?manifest_schema ?ok_key ?op_key ?probe_op ?probe_expect
           ?telemetry_root ?pool_strategy ?pool_size ?pool_size_source ?engine_id ?doc_example_op WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      OPTIONAL { ?c qri:abiVersion ?abiv }
      OPTIONAL { ?hp qri:otpApp ?a }
      OPTIONAL { ?hp qri:moduleRoot ?r }
      OPTIONAL { ?hp qri:taskModuleRoot ?tr }
      OPTIONAL { ?hp qri:freeSymbol ?fs }
      OPTIONAL { ?hp qri:lenType ?lt }
      OPTIONAL { ?hp qri:allocZeroPolicy ?azp }
      OPTIONAL { ?hp qri:outMode ?om }
      OPTIONAL { ?hp qri:reqConsumed ?rc }
      OPTIONAL { ?hp qri:pinFormat ?pf }
      OPTIONAL { ?hp qri:pathEnv ?pe }
      OPTIONAL { ?hp qri:handleNoun ?hn }
      OPTIONAL { ?hp qri:taxonomyNamespace ?tn }
      OPTIONAL { ?hp qri:refusalModule ?rm }
      OPTIONAL { ?hp qri:requestCap ?cap }
      OPTIONAL { ?hp qri:manifestRel ?mr }
      OPTIONAL { ?hp qri:wasmRel ?wr }
      OPTIONAL { ?hp qri:manifestSchema ?ms }
      OPTIONAL { ?hp qri:okKey ?ok }
      OPTIONAL { ?hp qri:opKey ?opk }
      OPTIONAL { ?hp qri:probeOp ?po }
      OPTIONAL { ?hp qri:probeExpectKey ?pek }
      OPTIONAL { ?hp qri:telemetryRoot ?tel }
      OPTIONAL { ?hp qri:poolStrategy ?ps }
      OPTIONAL { ?hp qri:poolSize ?psz }
      OPTIONAL { ?hp qri:poolSizeSource ?pss }
      OPTIONAL { ?hp qri:engineId ?eid }
      OPTIONAL { ?hp qri:docExampleOp ?deo }
      BIND(COALESCE(?a, "") AS ?app)
      BIND(COALESCE(?r, "") AS ?root)
      BIND(COALESCE(?tr, "") AS ?task_root)
      BIND(COALESCE(?abiv, "") AS ?abi_version)
      BIND(COALESCE(?fs, CONCAT(?prefix, "_free")) AS ?free_symbol)
      BIND(COALESCE(?lt, "u32") AS ?len_type)
      BIND(COALESCE(?azp, "refuse-resource_limit") AS ?alloc_zero_policy)
      BIND(COALESCE(?om, "packed_u64") AS ?out_mode)
      BIND(COALESCE(?rc, true) AS ?req_consumed)
      BIND(COALESCE(?pf, "") AS ?pin_format)
      BIND(COALESCE(?pe, "") AS ?path_env)
      BIND(COALESCE(?hn, "engine") AS ?handle_noun)
      BIND(COALESCE(?tn, "") AS ?taxonomy_ns)
      BIND(COALESCE(?rm, "") AS ?refusal_module)
      BIND(COALESCE(?cap, 0) AS ?request_cap)
      BIND(COALESCE(?mr, "") AS ?manifest_rel)
      BIND(COALESCE(?wr, "") AS ?wasm_rel)
      BIND(COALESCE(?ms, "") AS ?manifest_schema)
      BIND(COALESCE(?ok, "ok") AS ?ok_key)
      BIND(COALESCE(?opk, "op") AS ?op_key)
      BIND(COALESCE(?po, "") AS ?probe_op)
      BIND(COALESCE(?pek, "") AS ?probe_expect)
      BIND(COALESCE(?tel, "") AS ?telemetry_root)
      BIND(COALESCE(?ps, "single") AS ?pool_strategy)
      BIND(COALESCE(?psz, 1) AS ?pool_size)
      BIND(COALESCE(?pss, "") AS ?pool_size_source)
      BIND(COALESCE(?eid, "") AS ?engine_id)
      BIND(COALESCE(?deo, "") AS ?doc_example_op)
    }
    ORDER BY ?prefix
  exports: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?prefix ?name ?kind WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      { ?c qri:requiredExport ?name . BIND("required" AS ?kind) }
      UNION { ?c qri:optionalExport ?name . BIND("optional" AS ?kind) }
      UNION { ?hp qri:initExport ?name . BIND("init" AS ?kind) }
    }
    ORDER BY ?prefix ?kind ?name
force: true
---
{#- LOCAL DIVERGENCE from qri-qualification-profile-pack templates/beam-host: Refusal.new/3 third arg is keyword opts; upstream passes a bare map (details: wrapper added). See DIVERGENCE.md. -#}
{%- set p = profile[0] -%}
{%- set manifest_file = p.manifest_rel | split(pat="/") | last -%}
# GENERATED by qri-qualification-profile-pack (queries 50-54). Do not edit; edit the RDF contract.

defmodule {{ p.root }}.EngineLoad do
  @moduledoc """
  The load boundary for the {{ p.engine_id }} WASM engine.

  `admit/2` judges engine bytes (digest pin, compile, import surface, required exports) before any
  instance exists. Admission is not authority: it grants no DO.
  """

  alias {{ p.refusal_module }}
  alias {{ p.root }}.WasmConfig

  @import_module "wasi_snapshot_preview1"
  @required_exports [
{%- set_global first = true -%}
{%- for e in exports %}{% if e.kind == "required" %}{% if not first %}, {% endif %}"{{ e.name }}"{% set_global first = false %}{% endif %}{% endfor %}]
  @event [:{{ p.telemetry_root }}, :engine, :admit]

  @typedoc "An admitted engine. `engine`/`module` are handed to the host for instantiation."
  @type admitted :: %{
          wasm_sha256: String.t(),
          imports: %{optional(String.t()) => term()},
          exports: %{optional(String.t()) => term()},
          engine: Wasmex.Engine.t(),
          module: Wasmex.Module.t()
        }

  @doc "Exports the engine must provide."
  @spec required_exports() :: [String.t()]
  def required_exports, do: @required_exports

  @doc "The pinned engine SHA-256 (`{{ p.root }}.WasmConfig.pinned_sha256/0`)."
  @spec pinned_sha256() :: String.t() | nil
  def pinned_sha256, do: WasmConfig.pinned_sha256()

  @typedoc "Options for `admit/2`."
  @type opts :: [expected_sha256: String.t() | :unpinned | nil, fuel?: boolean(), wasm_path: String.t()]

  @doc "Compiles and admits `bytes`; see the module doc for the order of checks."
  @spec admit(binary(), opts()) :: {:ok, admitted()} | {:error, Refusal.t()}
  def admit(bytes, opts \\ [])

  def admit(bytes, opts) when is_binary(bytes) and is_list(opts) do
    digest = :crypto.hash(:sha256, bytes) |> Base.encode16(case: :lower)
    fuel? = Keyword.get(opts, :fuel?, true)
    expected = expected(opts)

    result =
      case :persistent_term.get(cache_key(digest, fuel?), nil) do
        %{} = entry -> with :ok <- check_digest(digest, expected), do: {:ok, entry}
        nil -> compile_and_admit(digest, bytes, fuel?, expected)
      end

    emit(digest, result)
    result
  end

  def admit(_bytes, _opts) do
    refusal = Refusal.new(:wasm_invalid, "engine bytes must be a binary")
    emit(nil, {:error, refusal})
    {:error, refusal}
  end

  @doc "Drops every cached compiled module."
  @spec purge_cache() :: :ok
  def purge_cache do
    for {{ "{{" }}__MODULE__, :compiled, _, _} = key, _} <- :persistent_term.get() do
      :persistent_term.erase(key)
    end

    :ok
  end

  @doc "Whether an admitted module for `{sha256, fuel?}` is cached on this node."
  @spec cached?(String.t(), boolean()) :: boolean()
  def cached?(digest, fuel? \\ true),
    do: :persistent_term.get(cache_key(digest, fuel?), nil) != nil

  defp cache_key(digest, fuel?), do: {__MODULE__, :compiled, digest, fuel?}

  defp expected(opts) do
    case Keyword.fetch(opts, :expected_sha256) do
      {:ok, value} -> value
      :error -> WasmConfig.expected_sha256(opts)
    end
  end

  # A hex pin is judged first: hashing is cheap, compiling untrusted bytes is not, and a
  # foreign module never needs a diagnosis when the caller already knows which bytes it
  # wants. With `:unpinned` (the caller chose the bytes) the surface diagnosis is the only
  # check that remains. Only bytes that pass every check are cached.
  defp compile_and_admit(digest, bytes, fuel?, expected) do
    with :ok <- check_digest(digest, expected),
         {:ok, engine, module} <- compile(bytes, fuel?),
         imports = Wasmex.Module.imports(module),
         exports = Wasmex.Module.exports(module),
         :ok <- check_imports(imports),
         :ok <- check_exports(exports) do
      entry = %{wasm_sha256: digest, imports: imports, exports: exports, engine: engine, module: module}
      :persistent_term.put(cache_key(digest, fuel?), entry)
      {:ok, entry}
    end
  end

  defp compile(bytes, fuel?) do
    config =
      if fuel?,
        do: Wasmex.EngineConfig.consume_fuel(%Wasmex.EngineConfig{}, true),
        else: %Wasmex.EngineConfig{}

    with {:ok, engine} <- engine_new(config),
         {:ok, store} <- store_new(engine),
         {:ok, module} <- module_compile(store, bytes) do
      {:ok, engine, module}
    end
  end

  defp engine_new(config) do
    case Wasmex.Engine.new(config) do
      {:ok, engine} -> {:ok, engine}
      {:error, reason} -> {:error, invalid(reason)}
    end
  end

  defp store_new(engine) do
    case Wasmex.Store.new(nil, engine) do
      {:ok, store} -> {:ok, store}
      {:error, reason} -> {:error, invalid(reason)}
    end
  end

  defp module_compile(store, bytes) do
    case Wasmex.Module.compile(store, bytes) do
      {:ok, module} -> {:ok, module}
      {:error, reason} -> {:error, invalid(reason)}
    end
  rescue
    error -> {:error, invalid(error)}
  end

  defp invalid(reason) do
    Refusal.new(:wasm_invalid, "engine bytes did not compile as a WebAssembly module", details: %{
      reason: inspect(reason, limit: 5)
    })
  end

  defp check_imports(imports) do
    case WasmConfig.import_allowlist() do
      {:ok, allow} -> judge_imports(imports, MapSet.new(allow))
      :unavailable -> {:error, allowlist_unavailable()}
    end
  end

  defp judge_imports(imports, allow) do
    unexpected_modules =
      imports |> Map.keys() |> Enum.reject(&(&1 == @import_module)) |> Enum.sort()

    unexpected_functions =
      for {module, functions} <- imports,
          module == @import_module,
          {name, type} <- functions,
          not MapSet.member?(allow, {name, type}),
          not MapSet.member?(allow, {name, :any}) do
        "#{module}.#{name}"
      end
      |> Enum.sort()

    if unexpected_modules == [] and unexpected_functions == [] do
      :ok
    else
      offenders = unexpected_modules ++ unexpected_functions

      {:error,
       Refusal.new(
         :wasm_import_surface_mismatch,
         "engine imports outside the allowlist: #{Enum.join(offenders, ", ")}",
         details: %{
           unexpected: unexpected_modules,
           unexpected_functions: unexpected_functions,
           allowed: [@import_module],
           allowed_functions: allow |> Enum.map(&elem(&1, 0)) |> Enum.sort()
         }
       )}
    end
  end

  defp allowlist_unavailable do
    Refusal.new(
      :wasm_import_surface_mismatch,
      "no import allowlist is available ({{ manifest_file }} host_abi.imports unusable); refusing every engine",
      details: %{unexpected: [], unexpected_functions: [], allowed: [@import_module], reason: "allowlist_unavailable"}
    )
  end

  defp check_exports(exports) do
    missing = Enum.reject(@required_exports, &Map.has_key?(exports, &1))

    if missing == [] do
      :ok
    else
      {:error,
       Refusal.new(:wasm_missing_export, "engine lacks required exports: #{Enum.join(missing, ", ")}", details: %{
         missing: missing,
         required: @required_exports
       })}
    end
  end

  defp check_digest(_digest, :unpinned), do: :ok
  defp check_digest(digest, digest) when is_binary(digest), do: :ok

  defp check_digest(digest, expected) do
    {:error,
     Refusal.new(:wasm_digest_mismatch, "engine sha256 does not match the pin", details: %{
       expected: expected,
       actual: digest
     })}
  end

  defp emit(digest, result) do
    {outcome, code} =
      case result do
        {:ok, _} -> {:admitted, nil}
        {:error, %Refusal{code: code}} -> {:refused, code}
      end

    :telemetry.execute(@event, %{}, %{outcome: outcome, code: code, wasm_sha256: digest})
  end
end
