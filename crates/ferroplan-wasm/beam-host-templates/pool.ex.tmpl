---
to: generated/beam-host/pool.ex
sparql:
  profile: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?app ?root ?task_root ?prefix ?abi_version ?free_symbol ?len_type ?alloc_zero_policy ?out_mode
           ?req_consumed ?pin_format ?path_env ?handle_noun ?taxonomy_ns ?refusal_module ?request_cap
           ?manifest_rel ?wasm_rel ?manifest_schema ?ok_key ?op_key ?probe_op ?probe_expect
           ?telemetry_root ?pool_strategy ?pool_size ?pool_size_source ?engine_id ?doc_example_op WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      OPTIONAL { ?c qri:abiVersion ?abiv }
      OPTIONAL { ?hp qri:otpApp ?a }
      OPTIONAL { ?hp qri:moduleRoot ?r }
      OPTIONAL { ?hp qri:taskModuleRoot ?tr }
      OPTIONAL { ?hp qri:freeSymbol ?fs }
      OPTIONAL { ?hp qri:lenType ?lt }
      OPTIONAL { ?hp qri:allocZeroPolicy ?azp }
      OPTIONAL { ?hp qri:outMode ?om }
      OPTIONAL { ?hp qri:reqConsumed ?rc }
      OPTIONAL { ?hp qri:pinFormat ?pf }
      OPTIONAL { ?hp qri:pathEnv ?pe }
      OPTIONAL { ?hp qri:handleNoun ?hn }
      OPTIONAL { ?hp qri:taxonomyNamespace ?tn }
      OPTIONAL { ?hp qri:refusalModule ?rm }
      OPTIONAL { ?hp qri:requestCap ?cap }
      OPTIONAL { ?hp qri:manifestRel ?mr }
      OPTIONAL { ?hp qri:wasmRel ?wr }
      OPTIONAL { ?hp qri:manifestSchema ?ms }
      OPTIONAL { ?hp qri:okKey ?ok }
      OPTIONAL { ?hp qri:opKey ?opk }
      OPTIONAL { ?hp qri:probeOp ?po }
      OPTIONAL { ?hp qri:probeExpectKey ?pek }
      OPTIONAL { ?hp qri:telemetryRoot ?tel }
      OPTIONAL { ?hp qri:poolStrategy ?ps }
      OPTIONAL { ?hp qri:poolSize ?psz }
      OPTIONAL { ?hp qri:poolSizeSource ?pss }
      OPTIONAL { ?hp qri:engineId ?eid }
      OPTIONAL { ?hp qri:docExampleOp ?deo }
      BIND(COALESCE(?a, "") AS ?app)
      BIND(COALESCE(?r, "") AS ?root)
      BIND(COALESCE(?tr, "") AS ?task_root)
      BIND(COALESCE(?abiv, "") AS ?abi_version)
      BIND(COALESCE(?fs, CONCAT(?prefix, "_free")) AS ?free_symbol)
      BIND(COALESCE(?lt, "u32") AS ?len_type)
      BIND(COALESCE(?azp, "refuse-resource_limit") AS ?alloc_zero_policy)
      BIND(COALESCE(?om, "packed_u64") AS ?out_mode)
      BIND(COALESCE(?rc, true) AS ?req_consumed)
      BIND(COALESCE(?pf, "") AS ?pin_format)
      BIND(COALESCE(?pe, "") AS ?path_env)
      BIND(COALESCE(?hn, "engine") AS ?handle_noun)
      BIND(COALESCE(?tn, "") AS ?taxonomy_ns)
      BIND(COALESCE(?rm, "") AS ?refusal_module)
      BIND(COALESCE(?cap, 0) AS ?request_cap)
      BIND(COALESCE(?mr, "") AS ?manifest_rel)
      BIND(COALESCE(?wr, "") AS ?wasm_rel)
      BIND(COALESCE(?ms, "") AS ?manifest_schema)
      BIND(COALESCE(?ok, "ok") AS ?ok_key)
      BIND(COALESCE(?opk, "op") AS ?op_key)
      BIND(COALESCE(?po, "") AS ?probe_op)
      BIND(COALESCE(?pek, "") AS ?probe_expect)
      BIND(COALESCE(?tel, "") AS ?telemetry_root)
      BIND(COALESCE(?ps, "single") AS ?pool_strategy)
      BIND(COALESCE(?psz, 1) AS ?pool_size)
      BIND(COALESCE(?pss, "") AS ?pool_size_source)
      BIND(COALESCE(?eid, "") AS ?engine_id)
      BIND(COALESCE(?deo, "") AS ?doc_example_op)
    }
    ORDER BY ?prefix
force: true
---
{#- LOCAL DIVERGENCE from qri-qualification-profile-pack templates/beam-host: Supervisor.init strategy fixed to :one_for_one; upstream feeds poolStrategy (e.g. :single) which Supervisor rejects; pool size stays ontology poolSize (1). See DIVERGENCE.md. -#}
{%- set p = profile[0] -%}
{%- if p.pool_size_source == "schedulers_online" -%}{%- set size_expr = "System.schedulers_online()" -%}{%- set size_doc = "System.schedulers_online/0" -%}{%- set size_words = "the scheduler count" -%}{%- else -%}{%- set size_expr = p.pool_size -%}{%- set size_doc = p.pool_size -%}{%- set size_words = "the configured size" -%}{%- endif -%}
# GENERATED by qri-qualification-profile-pack (queries 50-54). Do not edit; edit the RDF contract.

defmodule {{ p.root }}.Pool do
  @moduledoc """
  N supervised `{{ p.root }}.Host` instances behind one name.

  Routes each request to the member with the shortest mailbox; strategy `:one_for_one` (profile poolStrategy `{{ p.pool_strategy }}` names routing, not a
  Supervisor strategy) with the registry as the first child. Routing is not authority.
  """

  use Supervisor

  alias {{ p.refusal_module }}

  @registry {{ p.root }}.Pool.Registry
  @host {{ p.root }}.Host

  @typedoc "Pool options: `:name`, `:size`, plus any `{{ p.root }}.Host` option."
  @type opts :: [
          {:name, atom()}
          | {:size, pos_integer()}
          | {:wasm_path, String.t()}
          | {:bytes, binary()}
          | {:expected_sha256, String.t() | :unpinned}
          | {atom(), term()}
        ]

  @doc "The registry the pool's members join (under the key `:members`)."
  @spec registry() :: atom()
  def registry, do: @registry

  @doc """
  Starts the pool. Options: `:name` (supervisor name, default this module),
  `:size` (default `{{ size_doc }}`), and any `{{ p.root }}.Host`
  option, passed to every member.
  """
  @spec start_link(opts()) :: Supervisor.on_start()
  def start_link(opts \\ []) do
    {name, opts} = Keyword.pop(opts, :name, __MODULE__)
    Supervisor.start_link(__MODULE__, opts, name: name)
  end

  @doc false
  @impl Supervisor
  @spec init(opts()) :: {:ok, {Supervisor.sup_flags(), [Supervisor.child_spec()]}}
  def init(opts) do
    n = size(opts)
    host_opts = Keyword.drop(opts, [:size, :registry, :name])

    members =
      for i <- 0..(n - 1)//1 do
        name = if i == 0, do: @host, else: nil

        Supervisor.child_spec(
          {@host, Keyword.merge(host_opts, name: name, registry: @registry)},
          id: {@host, i}
        )
      end

    Supervisor.init([{Registry, keys: :duplicate, name: @registry} | members], strategy: :one_for_one)
  end

  @doc "Pool size resolved from `opts[:size]`, then {{ size_words }}."
  @spec size(opts()) :: pos_integer()
  def size(opts \\ []) do
    case Keyword.get(opts, :size) do
      n when is_integer(n) and n > 0 -> n
      _ -> {{ size_expr }}
    end
  end

  @doc """
  Routes `request` to the member with the shortest mailbox via
  `{{ p.root }}.Host.request/3`. With no live member, returns a
  `:host_not_started` refusal.
  """
  @spec request(map(), keyword()) :: {:ok, map()} | {:error, Refusal.t()}
  def request(request, opts \\ []) when is_map(request) do
    case pick() || List.first(unavailable_members()) do
      nil ->
        {:error, Refusal.new(:host_not_started, "no {{ p.root }}.Host member is registered in the pool")}

      pid ->
        {{ p.root }}.Host.request(pid, request, opts)
    end
  end

  @doc """
  Engine identity of the pool: `{{ p.root }}.Host.info/2` of the first live member
  (`{:ok, %{wasm_sha256: _, ...}}`), or a typed refusal when no member is live.
  """
  @spec info(atom()) :: {:ok, map()} | {:error, Refusal.t()}
  def info(registry \\ @registry) do
    case registry |> members() |> Enum.sort() |> List.first() do
      nil -> {:error, Refusal.new(:host_not_started, "no live {{ p.root }}.Host member is registered in the pool")}
      pid -> {{ p.root }}.Host.info(pid)
    end
  end

  @doc "The live member with the shortest mailbox, or `nil` when none is routable."
  @spec pick(atom()) :: pid() | nil
  def pick(registry \\ @registry) do
    # Shuffled first: a burst of callers reads the same (often all-zero) mailbox lengths, and
    # `Enum.min_by/3` would send every one of them to the first member of the list.
    registry
    |> members()
    |> Enum.shuffle()
    |> Enum.map(fn pid -> {queue_len(pid), pid} end)
    |> Enum.reject(fn {len, _pid} -> is_nil(len) end)
    |> Enum.min_by(&elem(&1, 0), fn -> {nil, nil} end)
    |> elem(1)
  end

  @doc "Every live member pid."
  @spec members(atom()) :: [pid()]
  def members(registry \\ @registry), do: registered(registry, :members)

  @doc "Every member pid whose engine is currently unavailable (still supervised, retrying)."
  @spec unavailable_members(atom()) :: [pid()]
  def unavailable_members(registry \\ @registry), do: registered(registry, :unavailable)

  defp registered(registry, key) do
    if Process.whereis(registry),
      do: registry |> Registry.lookup(key) |> Enum.map(&elem(&1, 0)),
      else: []
  rescue
    # A registry mid-restart has its name registered before its key table
    # exists; `Registry.lookup/2` raises. No member is routable in that window.
    ArgumentError -> []
  end

  defp queue_len(pid) do
    case Process.info(pid, :message_queue_len) do
      {:message_queue_len, len} -> len
      nil -> nil
    end
  end
end
