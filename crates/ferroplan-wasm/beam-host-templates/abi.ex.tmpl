---
to: generated/beam-host/abi.ex
sparql:
  profile: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?app ?root ?task_root ?prefix ?abi_version ?free_symbol ?len_type ?alloc_zero_policy ?out_mode
           ?req_consumed ?pin_format ?path_env ?handle_noun ?taxonomy_ns ?refusal_module ?request_cap
           ?manifest_rel ?wasm_rel ?manifest_schema ?ok_key ?op_key ?probe_op ?probe_expect
           ?telemetry_root ?pool_strategy ?pool_size ?pool_size_source ?engine_id ?doc_example_op WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      OPTIONAL { ?c qri:abiVersion ?abiv }
      OPTIONAL { ?hp qri:otpApp ?a }
      OPTIONAL { ?hp qri:moduleRoot ?r }
      OPTIONAL { ?hp qri:taskModuleRoot ?tr }
      OPTIONAL { ?hp qri:freeSymbol ?fs }
      OPTIONAL { ?hp qri:lenType ?lt }
      OPTIONAL { ?hp qri:allocZeroPolicy ?azp }
      OPTIONAL { ?hp qri:outMode ?om }
      OPTIONAL { ?hp qri:reqConsumed ?rc }
      OPTIONAL { ?hp qri:pinFormat ?pf }
      OPTIONAL { ?hp qri:pathEnv ?pe }
      OPTIONAL { ?hp qri:handleNoun ?hn }
      OPTIONAL { ?hp qri:taxonomyNamespace ?tn }
      OPTIONAL { ?hp qri:refusalModule ?rm }
      OPTIONAL { ?hp qri:requestCap ?cap }
      OPTIONAL { ?hp qri:manifestRel ?mr }
      OPTIONAL { ?hp qri:wasmRel ?wr }
      OPTIONAL { ?hp qri:manifestSchema ?ms }
      OPTIONAL { ?hp qri:okKey ?ok }
      OPTIONAL { ?hp qri:opKey ?opk }
      OPTIONAL { ?hp qri:probeOp ?po }
      OPTIONAL { ?hp qri:probeExpectKey ?pek }
      OPTIONAL { ?hp qri:telemetryRoot ?tel }
      OPTIONAL { ?hp qri:poolStrategy ?ps }
      OPTIONAL { ?hp qri:poolSize ?psz }
      OPTIONAL { ?hp qri:poolSizeSource ?pss }
      OPTIONAL { ?hp qri:engineId ?eid }
      OPTIONAL { ?hp qri:docExampleOp ?deo }
      BIND(COALESCE(?a, "") AS ?app)
      BIND(COALESCE(?r, "") AS ?root)
      BIND(COALESCE(?tr, "") AS ?task_root)
      BIND(COALESCE(?abiv, "") AS ?abi_version)
      BIND(COALESCE(?fs, CONCAT(?prefix, "_free")) AS ?free_symbol)
      BIND(COALESCE(?lt, "u32") AS ?len_type)
      BIND(COALESCE(?azp, "refuse-resource_limit") AS ?alloc_zero_policy)
      BIND(COALESCE(?om, "packed_u64") AS ?out_mode)
      BIND(COALESCE(?rc, true) AS ?req_consumed)
      BIND(COALESCE(?pf, "") AS ?pin_format)
      BIND(COALESCE(?pe, "") AS ?path_env)
      BIND(COALESCE(?hn, "engine") AS ?handle_noun)
      BIND(COALESCE(?tn, "") AS ?taxonomy_ns)
      BIND(COALESCE(?rm, "") AS ?refusal_module)
      BIND(COALESCE(?cap, 0) AS ?request_cap)
      BIND(COALESCE(?mr, "") AS ?manifest_rel)
      BIND(COALESCE(?wr, "") AS ?wasm_rel)
      BIND(COALESCE(?ms, "") AS ?manifest_schema)
      BIND(COALESCE(?ok, "ok") AS ?ok_key)
      BIND(COALESCE(?opk, "op") AS ?op_key)
      BIND(COALESCE(?po, "") AS ?probe_op)
      BIND(COALESCE(?pek, "") AS ?probe_expect)
      BIND(COALESCE(?tel, "") AS ?telemetry_root)
      BIND(COALESCE(?ps, "single") AS ?pool_strategy)
      BIND(COALESCE(?psz, 1) AS ?pool_size)
      BIND(COALESCE(?pss, "") AS ?pool_size_source)
      BIND(COALESCE(?eid, "") AS ?engine_id)
      BIND(COALESCE(?deo, "") AS ?doc_example_op)
    }
    ORDER BY ?prefix
force: true
---
{#- LOCAL DIVERGENCE from qri-qualification-profile-pack templates/beam-host: Refusal.new/3 third arg is keyword opts; upstream passes a bare map (details: wrapper added). See DIVERGENCE.md. -#}
{%- set p = profile[0] -%}
{%- set mib = (p.request_cap / 1048576) | int -%}
# GENERATED by qri-qualification-profile-pack (queries 50-54). Do not edit; edit the RDF contract.

defmodule {{ p.root }}.ABI do
  @moduledoc """
  Pure codec for {{ p.engine_id }} ABI {{ p.abi_version }}: request encoding and packed-result unpacking.

  Holds no process state and makes no Wasmex calls. Decoding is not authority.
  """

  import Bitwise

  alias {{ p.refusal_module }}

  @abi_version {{ p.abi_version }}
  @u64 0x1_0000_0000_0000_0000
  @u32_mask 0xFFFF_FFFF
  @max_request_bytes {{ mib }} * 1_048_576

  @doc "The ABI version this build of the library speaks."
  @spec version() :: pos_integer()
  def version, do: @abi_version

  @doc "Maximum encoded request size in bytes."
  @spec max_request_bytes() :: pos_integer()
  def max_request_bytes, do: @max_request_bytes

  @doc """
  Splits a packed `{{ p.prefix }}_call` result into `{ptr, len}`.

  Negative integers (a signed `i64` view of the same 64 bits) are normalized by adding
  `2^64`.

  ## Examples

      iex> {{ p.root }}.ABI.unpack_result(Bitwise.bsl(123, 32) + 45)
      {123, 45}

      iex> {{ p.root }}.ABI.unpack_result(-1)
      {4_294_967_295, 4_294_967_295}
  """
  @spec unpack_result(integer()) :: {non_neg_integer(), non_neg_integer()}
  def unpack_result(packed) when is_integer(packed) do
    unsigned = if packed < 0, do: packed + @u64, else: packed
    {unsigned >>> 32 &&& @u32_mask, unsigned &&& @u32_mask}
  end

  @doc """
  Encodes a request map (string keys) as JSON bytes.

  Returns `{:error, %Refusal{code: :resource_limit}}` above the {{ mib }} MiB cap and
  `{:error, %Refusal{code: :invalid_json}}` when the term cannot be JSON-encoded, and
  `{:error, %Refusal{code: :invalid_encoding}}` when a string in it is not valid UTF-8.
  """
  @spec encode_request(map()) :: {:ok, binary()} | {:error, Refusal.t()}
  def encode_request(request) when is_map(request) do
    case safe_encode(request) do
      {:ok, payload} when byte_size(payload) > @max_request_bytes ->
        {:error,
         Refusal.new(:resource_limit, "request exceeds the {{ mib }} MiB ABI limit", details: %{
           bytes: byte_size(payload),
           limit: @max_request_bytes
         })}

      {:ok, payload} ->
        {:ok, payload}

      :invalid_encoding ->
        {:error, Refusal.new(:invalid_encoding, "request contains text that is not valid UTF-8")}

      {:error, message} ->
        {:error, Refusal.new(:invalid_json, "request is not JSON-encodable: " <> message)}
    end
  end

  @doc """
  Decodes response bytes into a map.

  Non-JSON bytes yield `:invalid_json`; JSON that is not an object yields
  `:malformed_response`. Both `"ok": true` and `"ok": false` bodies decode to `{:ok, map}`;
  classifying them is the caller's job.
  """
  @spec decode_response(binary()) :: {:ok, map()} | {:error, Refusal.t()}
  def decode_response(body) when is_binary(body) do
    case Jason.decode(body) do
      {:ok, %{} = response} ->
        {:ok, response}

      {:ok, _other} ->
        {:error, Refusal.new(:malformed_response, "{{ p.engine_id }} response is not a JSON object")}

      {:error, reason} ->
        {:error, Refusal.new(:invalid_json, Exception.message(reason), details: %{bytes: byte_size(body)})}
    end
  end

  defp safe_encode(request) do
    case Jason.encode(request) do
      {:ok, payload} -> {:ok, payload}
      {:error, reason} -> classify_encode_error(reason)
    end
  rescue
    error -> classify_encode_error(error)
  end

  # Jason rejects a string that is not valid UTF-8 before any byte reaches the engine; that is an
  # encoding refusal, not a JSON-shape one. The message (which would quote the offending text) is
  # deliberately not propagated for it.
  defp classify_encode_error(%Jason.EncodeError{message: "invalid byte " <> _rest}), do: :invalid_encoding
  defp classify_encode_error(error), do: {:error, Exception.message(error)}
end
