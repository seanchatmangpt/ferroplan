        path: path,
        opts: opts,
        wasm_sha256: admitted.wasm_sha256,
        engine: admitted.engine,
        module: admitted.module,
        initialize?: {% if init_export != "" %}Map.has_key?(admitted.exports, "{{ init_export }}"){% else %}false{% endif %},
        limits: WasmConfig.limits(opts),
