{%- for l in limits %}{% if l.name == "abi_timeout" %}{% set_global lim_abi_timeout = l.default %}{% endif %}{% endfor -%}
{%- for l in limits %}{% if l.name == "margin" %}{% set_global lim_margin = l.default %}{% endif %}{% endfor -%}
{%- for l in limits %}{% if l.name == "retry_base_ms" %}{% set_global lim_retry_base_ms = l.default %}{% endif %}{% endfor -%}
{%- for l in limits %}{% if l.name == "retry_max_ms" %}{% set_global lim_retry_max_ms = l.default %}{% endif %}{% endfor -%}
