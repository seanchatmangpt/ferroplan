  rescue
    error -> {:error, Exception.message(error)}
  catch
    :exit, reason -> {:error, reason}
  end

  defp failed_instantiation(reason) do
    Refusal.new(:instantiation_failed, "engine instantiation failed", details: %{reason: inspect(reason, limit: 5)})
  end

{% if init_export != "" %}  # Reactor-style modules export `{{ init_export }}`; call it exactly once per instance.
