      {:error, :enoent} ->
        {:error, Refusal.new(:wasm_not_vendored, "no engine at #{path}; run `mix {{ p.app }}.vendor`", details: %{path: path})}

      {:error, reason} ->
        {:error, Refusal.new(:wasm_unreadable, "cannot read #{path}: #{:file.format_error(reason)}", details: %{path: path})}
    end
  end

  # One fresh WASI store + instance over the cached compiled module.
  defp instantiate(%{engine: engine, module: module, limits: limits} = state) do
