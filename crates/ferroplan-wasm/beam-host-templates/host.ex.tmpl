---
to: generated/beam-host/host.ex
sparql:
  profile: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?app ?root ?task_root ?prefix ?abi_version ?free_symbol ?len_type ?alloc_zero_policy ?out_mode
           ?req_consumed ?pin_format ?path_env ?handle_noun ?taxonomy_ns ?refusal_module ?request_cap
           ?manifest_rel ?wasm_rel ?manifest_schema ?ok_key ?op_key ?probe_op ?probe_expect
           ?telemetry_root ?pool_strategy ?pool_size ?pool_size_source ?engine_id ?doc_example_op WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      OPTIONAL { ?c qri:abiVersion ?abiv }
      OPTIONAL { ?hp qri:otpApp ?a }
      OPTIONAL { ?hp qri:moduleRoot ?r }
      OPTIONAL { ?hp qri:taskModuleRoot ?tr }
      OPTIONAL { ?hp qri:freeSymbol ?fs }
      OPTIONAL { ?hp qri:lenType ?lt }
      OPTIONAL { ?hp qri:allocZeroPolicy ?azp }
      OPTIONAL { ?hp qri:outMode ?om }
      OPTIONAL { ?hp qri:reqConsumed ?rc }
      OPTIONAL { ?hp qri:pinFormat ?pf }
      OPTIONAL { ?hp qri:pathEnv ?pe }
      OPTIONAL { ?hp qri:handleNoun ?hn }
      OPTIONAL { ?hp qri:taxonomyNamespace ?tn }
      OPTIONAL { ?hp qri:refusalModule ?rm }
      OPTIONAL { ?hp qri:requestCap ?cap }
      OPTIONAL { ?hp qri:manifestRel ?mr }
      OPTIONAL { ?hp qri:wasmRel ?wr }
      OPTIONAL { ?hp qri:manifestSchema ?ms }
      OPTIONAL { ?hp qri:okKey ?ok }
      OPTIONAL { ?hp qri:opKey ?opk }
      OPTIONAL { ?hp qri:probeOp ?po }
      OPTIONAL { ?hp qri:probeExpectKey ?pek }
      OPTIONAL { ?hp qri:telemetryRoot ?tel }
      OPTIONAL { ?hp qri:poolStrategy ?ps }
      OPTIONAL { ?hp qri:poolSize ?psz }
      OPTIONAL { ?hp qri:poolSizeSource ?pss }
      OPTIONAL { ?hp qri:engineId ?eid }
      OPTIONAL { ?hp qri:docExampleOp ?deo }
      BIND(COALESCE(?a, "") AS ?app)
      BIND(COALESCE(?r, "") AS ?root)
      BIND(COALESCE(?tr, "") AS ?task_root)
      BIND(COALESCE(?abiv, "") AS ?abi_version)
      BIND(COALESCE(?fs, CONCAT(?prefix, "_free")) AS ?free_symbol)
      BIND(COALESCE(?lt, "u32") AS ?len_type)
      BIND(COALESCE(?azp, "refuse-resource_limit") AS ?alloc_zero_policy)
      BIND(COALESCE(?om, "packed_u64") AS ?out_mode)
      BIND(COALESCE(?rc, true) AS ?req_consumed)
      BIND(COALESCE(?pf, "") AS ?pin_format)
      BIND(COALESCE(?pe, "") AS ?path_env)
      BIND(COALESCE(?hn, "engine") AS ?handle_noun)
      BIND(COALESCE(?tn, "") AS ?taxonomy_ns)
      BIND(COALESCE(?rm, "") AS ?refusal_module)
      BIND(COALESCE(?cap, 0) AS ?request_cap)
      BIND(COALESCE(?mr, "") AS ?manifest_rel)
      BIND(COALESCE(?wr, "") AS ?wasm_rel)
      BIND(COALESCE(?ms, "") AS ?manifest_schema)
      BIND(COALESCE(?ok, "ok") AS ?ok_key)
      BIND(COALESCE(?opk, "op") AS ?op_key)
      BIND(COALESCE(?po, "") AS ?probe_op)
      BIND(COALESCE(?pek, "") AS ?probe_expect)
      BIND(COALESCE(?tel, "") AS ?telemetry_root)
      BIND(COALESCE(?ps, "single") AS ?pool_strategy)
      BIND(COALESCE(?psz, 1) AS ?pool_size)
      BIND(COALESCE(?pss, "") AS ?pool_size_source)
      BIND(COALESCE(?eid, "") AS ?engine_id)
      BIND(COALESCE(?deo, "") AS ?doc_example_op)
    }
    ORDER BY ?prefix
  limits: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?prefix ?name ?default ?order ?zero_ok ?zero_meaning WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      ?hp qri:hostLimit ?l .
      ?l qri:limitName ?name ; qri:limitDefault ?default ; qri:limitOrder ?order .
      OPTIONAL { ?l qri:limitZeroOk ?z }
      OPTIONAL { ?l qri:limitZeroMeaning ?zm }
      BIND(COALESCE(?z, false) AS ?zero_ok)
      BIND(COALESCE(?zm, "") AS ?zero_meaning)
    }
    ORDER BY ?prefix ?order ?name
  exports: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?prefix ?name ?kind WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      { ?c qri:requiredExport ?name . BIND("required" AS ?kind) }
      UNION { ?c qri:optionalExport ?name . BIND("optional" AS ?kind) }
      UNION { ?hp qri:initExport ?name . BIND("init" AS ?kind) }
    }
    ORDER BY ?prefix ?kind ?name
  recycle: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?prefix ?code ?order WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      ?hp qri:recycleOn ?code .
      OPTIONAL { ?hp qri:recycleRule ?r . ?r qri:recycleCode ?code ; qri:recycleOrder ?o }
      BIND(COALESCE(?o, 1000000) AS ?order)
    }
    ORDER BY ?prefix ?order ?code
force: true
