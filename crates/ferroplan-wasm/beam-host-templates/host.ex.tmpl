  use GenServer

  alias {{ p.root }}.ABI
  alias {{ p.root }}.EngineLoad
  alias {{ p.refusal_module }}
  alias {{ p.root }}.WasmConfig

  require Logger

  # Bound for the small ABI helper calls ({{ p.prefix }}_alloc, {{ p.free_symbol }}{% if init_export != "" %}, {{ init_export }} probe{% endif %}).
  @abi_timeout {{ self::us(n=lim_abi_timeout) }}
  @margin {{ self::us(n=lim_margin) }}
  @recycle_codes [
{%- set_global first = true -%}
{%- for r in recycle %}{% if not first %}, {% endif %}:{{ r.code }}{% set_global first = false %}{% endfor %}]
  @retry_base_ms {{ self::us(n=lim_retry_base_ms) }}
  @retry_max_ms {{ self::us(n=lim_retry_max_ms) }}

