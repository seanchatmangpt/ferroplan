;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty0)
    (pr1 ?a0 - ty1 ?a1 - ty0)
    (pr2)
  )
  (:task tk0 :parameters (?v0 - ty0))
  (:task tk1 :parameters (?v0 - ty0))
  (:task tk2 :parameters (?v0 - ty0 ?v1 - ty1))
  (:task tk3 :parameters (?v0 - ty0 ?v1 - ty1))
  (:task tk4 :parameters (?v0 - ty1))
  (:action ac0 :parameters (?v0 - ty0 ?v1 - ty0) :effect (oneof (and (pr0 ?v1 ?v0)) (and (pr2) (not (pr2)))))
  (:action ac1 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr2) (pr2)) :effect (and (pr0 ?v0 ?v1) (pr0 ?v0 ?v1) (not (pr2))))
  (:method mt0 :parameters (?v0 - ty0) :task (tk0 ?v0) :subtasks (and (s0 (ac0 ?v0 ?v0))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty0) :task (tk1 ?v0) :subtasks (and (s0 (ac0 ?v0 ?v0))) :ordering (and ))
  (:method mt2 :parameters (?v0 - ty0) :task (tk1 ?v0) :precondition (and (pr2) (not (pr0 ?v0 ?v0))) :ordered-subtasks (and (s0 (tk0 ?v0)) (s1 (ac1 ?v0 ?v0)) (s2 (tk0 ?v0)) (s3 (ac0 ?v0 ?v0))))
  (:method mt3 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk2 ?v0 ?v1) :ordered-subtasks (and (s0 (ac0 ?v0 ?v0))))
  (:method mt4 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk2 ?v0 ?v1) :precondition (and (pr2) (pr0 ?v0 ?v0)) :ordered-subtasks (and (s0 (tk0 ?v0)) (s1 (ac0 ?v0 ?v0)) (s2 (ac1 ?v0 ?v0))))
  (:method mt5 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk3 ?v0 ?v1) :ordered-subtasks (and (s0 (ac0 ?v0 ?v0))))
  (:method mt6 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk3 ?v0 ?v1) :subtasks (and (s0 (tk0 ?v0))) :ordering (and ))
  (:method mt7 :parameters (?v0 - ty1) :task (tk4 ?v0) :ordered-subtasks (and))
  (:method mt8 :parameters (?v0 - ty1) :task (tk4 ?v0) :precondition (and (pr2)) :ordered-subtasks (and))
)
