;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0)
  (:predicates
    (pr0)
    (pr1)
    (pr2)
    (pr3 ?a0 - ty0 ?a1 - ty0)
  )
  (:task tk0 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk2 :parameters (?v0 - ty0))
  (:task tk3 :parameters ())
  (:task tk4 :parameters ())
  (:action ac0 :parameters (?v0 - ty0 ?v1 - ty0) :effect (oneof (and (not (pr3 ?v0 ?v1)) (pr2)) (and (pr0)) (and (not (pr2)) (pr0)) (and)))
  (:action ac1 :parameters (?v0 - ty0) :precondition (and (pr1)) :effect (oneof (and) (and (pr3 ?v0 ?v0))))
  (:action ac2 :parameters () :effect (and (pr2) (pr1) (pr1)))
  (:action ac3 :parameters (?v0 - ty0) :precondition (and (pr2)) :effect (oneof (and (pr0)) (and (pr3 ?v0 ?v0)) (and) (and (not (pr1)) (pr2))))
  (:action ac4 :parameters (?v0 - ty0) :effect (and (pr3 ?v0 ?v0) (pr3 ?v0 ?v0)))
  (:method mt0 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk0 ?v0 ?v1) :ordered-subtasks (and (s0 (ac4 ?v0))))
  (:method mt1 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac4 ?v0))))
  (:method mt2 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk1 ?v0 ?v1) :precondition (and (pr2)) :ordered-subtasks (and (s0 (tk3))))
  (:method mt3 :parameters (?v0 - ty0) :task (tk2 ?v0) :ordered-subtasks (and (s0 (ac0 ?v0 ?v0))))
  (:method mt4 :parameters () :task (tk3) :ordered-subtasks (and (s0 (ac2))))
  (:method mt5 :parameters () :task (tk4) :ordered-subtasks (and (s0 (ac2))))
)
