;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0)
    (pr1 ?a0 - ty0 ?a1 - ty0)
    (pr2)
    (pr3)
  )
  (:task tk0 :parameters (?v0 - ty1))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty1))
  (:task tk2 :parameters (?v0 - ty1 ?v1 - ty1))
  (:task tk3 :parameters (?v0 - ty1))
  (:task tk4 :parameters (?v0 - ty0 ?v1 - ty1))
  (:task tk5 :parameters ())
  (:action ac0 :parameters (?v0 - ty1 ?v1 - ty0) :effect (oneof (and) (and) (and)))
  (:action ac1 :parameters () :effect (and (pr2) (pr0) (pr0)))
  (:action ac2 :parameters () :effect (and (not (pr0)) (not (pr2))))
  (:action ac3 :parameters (?v0 - ty0) :effect (oneof (and (pr3) (pr1 ?v0 ?v0) (pr3)) (and (not (pr0)) (pr1 ?v0 ?v0)) (and (pr2)) (and (pr3) (pr3))))
  (:action ac4 :parameters () :precondition (and (pr2)) :effect (and (not (pr2))))
  (:method mt0 :parameters (?v0 - ty1) :task (tk0 ?v0) :ordered-subtasks (and (s0 (ac1))))
  (:method mt1 :parameters (?v0 - ty1) :task (tk0 ?v0) :ordered-subtasks (and (s0 (ac2)) (s1 (tk3 ?v0))))
  (:method mt2 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac0 ?v1 ?v0))))
  (:method mt3 :parameters (?v0 - ty1 ?v1 - ty1) :task (tk2 ?v0 ?v1) :subtasks (and (s0 (ac1))) :ordering (and ))
  (:method mt4 :parameters (?v0 - ty1) :task (tk3 ?v0) :ordered-subtasks (and (s0 (ac1))))
  (:method mt5 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk4 ?v0 ?v1) :ordered-subtasks (and (s0 (ac2))))
  (:method mt6 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk4 ?v0 ?v1) :precondition (and (not (pr2)) (pr1 ?v0 ?v0)) :ordered-subtasks (and (s0 (tk5))))
  (:method mt7 :parameters () :task (tk5) :ordered-subtasks (and (s0 (ac1))))
  (:method mt8 :parameters () :task (tk5) :subtasks (and (s0 (ac2))) :ordering (and ))
)
