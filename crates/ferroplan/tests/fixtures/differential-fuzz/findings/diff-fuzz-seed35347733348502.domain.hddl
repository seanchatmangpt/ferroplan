;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty0)
    (pr1 ?a0 - ty1 ?a1 - ty1)
    (pr2)
    (pr3)
  )
  (:task tk0 :parameters (?v0 - ty1))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty1))
  (:action ac0 :parameters () :effect (and (pr2) (pr2) (pr3)))
  (:action ac1 :parameters (?v0 - ty0) :precondition (and (pr2)) :effect (and (pr0 ?v0) (pr3) (pr3)))
  (:action ac2 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr2) (pr0 ?v1)) :effect (and (pr2)))
  (:action ac3 :parameters (?v0 - ty0) :precondition (and (not (pr2)) (pr3)) :effect (and (pr2) (not (pr3))))
  (:method mt0 :parameters (?v0 - ty1) :task (tk0 ?v0) :ordered-subtasks (and (s0 (ac0))))
  (:method mt1 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk1 ?v0 ?v1) :subtasks (and (s0 (ac0))) :ordering (and ))
)
