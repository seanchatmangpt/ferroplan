;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty0)
    (pr1)
    (pr2 ?a0 - ty1)
    (pr3 ?a0 - ty0)
    (pr4 ?a0 - ty0 ?a1 - ty1)
  )
  (:task tk0 :parameters ())
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk2 :parameters (?v0 - ty0))
  (:task tk3 :parameters (?v0 - ty1 ?v1 - ty1))
  (:action ac0 :parameters (?v0 - ty0) :effect (and (not (pr0 ?v0 ?v0)) (pr1)))
  (:action ac1 :parameters (?v0 - ty0) :precondition (and (pr0 ?v0 ?v0) (pr1) (pr3 ?v0)) :effect (and (pr0 ?v0 ?v0)))
  (:action ac2 :parameters () :effect (and (pr1)))
  (:action ac3 :parameters (?v0 - ty1 ?v1 - ty0) :effect (oneof (and (pr4 ?v1 ?v0) (pr4 ?v1 ?v0)) (and (pr4 ?v1 ?v0))))
  (:method mt0 :parameters () :task (tk0) :subtasks (and (s0 (ac2))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac2))))
  (:method mt2 :parameters (?v0 - ty0) :task (tk2 ?v0) :ordered-subtasks (and (s0 (ac2))))
  (:method mt3 :parameters (?v0 - ty0) :task (tk2 ?v0) :precondition (and (pr0 ?v0 ?v0) (pr3 ?v0)) :ordered-subtasks (and (s0 (tk1 ?v0 ?v0)) (s1 (tk0))))
  (:method mt4 :parameters (?v0 - ty1 ?v1 - ty1) :task (tk3 ?v0 ?v1) :ordered-subtasks (and (s0 (ac2))))
)
