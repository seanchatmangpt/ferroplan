;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0)
  (:predicates
    (pr0 ?a0 - ty0)
    (pr1 ?a0 - ty0 ?a1 - ty0)
    (pr2)
    (pr3)
    (pr4)
  )
  (:task tk0 :parameters (?v0 - ty0))
  (:task tk1 :parameters (?v0 - ty0))
  (:task tk2 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk3 :parameters ())
  (:task tk4 :parameters ())
  (:action ac0 :parameters (?v0 - ty0 ?v1 - ty0) :effect (oneof (and (not (pr4)) (pr3)) (and)))
  (:action ac1 :parameters () :precondition (and (pr2)) :effect (and (pr4) (pr2)))
  (:action ac2 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr1 ?v1 ?v0) (not (pr2))) :effect (and (pr2) (pr1 ?v0 ?v0) (not (pr1 ?v0 ?v1))))
  (:action ac3 :parameters () :precondition (and (pr4) (pr2)) :effect (oneof (and (pr4)) (and (pr4) (pr4))))
  (:action ac4 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr3)) :effect (oneof (and (pr0 ?v1) (pr2)) (and) (and)))
  (:action ac5 :parameters () :effect (oneof (and (pr3) (pr2)) (and)))
  (:action ac6 :parameters (?v0 - ty0) :effect (and (pr0 ?v0) (pr0 ?v0)))
  (:action ac7 :parameters (?v0 - ty0 ?v1 - ty0) :effect (oneof (and (pr1 ?v1 ?v1)) (and) (and (pr4)) (and (pr4) (not (pr1 ?v1 ?v1)))))
  (:method mt0 :parameters (?v0 - ty0) :task (tk0 ?v0) :subtasks (and (s0 (ac7 ?v0 ?v0))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty0) :task (tk1 ?v0) :subtasks (and (s0 (ac7 ?v0 ?v0))) :ordering (and ))
  (:method mt2 :parameters (?v0 - ty0) :task (tk1 ?v0) :precondition (and (pr0 ?v0) (pr1 ?v0 ?v0)) :ordered-subtasks (and (s0 (tk4)) (s1 (ac7 ?v0 ?v0)) (s2 (ac1))))
  (:method mt3 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk2 ?v0 ?v1) :ordered-subtasks (and (s0 (ac6 ?v0))))
  (:method mt4 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk2 ?v0 ?v1) :precondition (and (not (pr4)) (not (pr1 ?v1 ?v1))) :subtasks (and (s0 (tk0 ?v0)) (s1 (ac7 ?v1 ?v1)) (s2 (tk4))) :ordering (and (< s0 s1) (< s1 s2)))
  (:method mt5 :parameters () :task (tk3) :subtasks (and (s0 (ac5))) :ordering (and ))
  (:method mt6 :parameters () :task (tk4) :subtasks (and (s0 (ac5))) :ordering (and ))
)
