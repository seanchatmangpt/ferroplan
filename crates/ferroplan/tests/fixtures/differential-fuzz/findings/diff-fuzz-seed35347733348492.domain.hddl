;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty1)
    (pr1 ?a0 - ty0 ?a1 - ty0)
    (pr2 ?a0 - ty0 ?a1 - ty1)
  )
  (:task tk0 :parameters (?v0 - ty1))
  (:task tk1 :parameters (?v0 - ty1))
  (:task tk2 :parameters ())
  (:action ac0 :parameters () :effect (and ))
  (:action ac1 :parameters (?v0 - ty1 ?v1 - ty1) :effect (and ))
  (:action ac2 :parameters (?v0 - ty0 ?v1 - ty1) :effect (oneof (and (not (pr1 ?v0 ?v0)) (pr1 ?v0 ?v0)) (and (not (pr1 ?v0 ?v0)))))
  (:method mt0 :parameters (?v0 - ty1) :task (tk0 ?v0) :subtasks (and (s0 (ac0))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty1) :task (tk1 ?v0) :subtasks (and (s0 (ac1 ?v0 ?v0))) :ordering (and ))
  (:method mt2 :parameters (?v0 - ty1) :task (tk1 ?v0) :ordered-subtasks (and (s0 (tk1 ?v0)) (s1 (tk0 ?v0)) (s2 (ac1 ?v0 ?v0))))
  (:method mt3 :parameters () :task (tk2) :ordered-subtasks (and (s0 (ac0))))
)
