;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty1 ?a1 - ty1)
    (pr1)
    (pr2)
  )
  (:task tk0 :parameters (?v0 - ty0))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty0))
  (:action ac0 :parameters (?v0 - ty0) :effect (and (not (pr1))))
  (:action ac1 :parameters () :precondition (and (pr2)) :effect (and (pr2) (not (pr2))))
  (:action ac2 :parameters (?v0 - ty1 ?v1 - ty0) :precondition (and (not (pr2)) (pr1)) :effect (and (not (pr0 ?v0 ?v0))))
  (:action ac3 :parameters (?v0 - ty0) :effect (and (pr1) (pr1) (pr1)))
  (:action ac4 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr2) (pr1) (pr1)) :effect (and (pr2) (not (pr2)) (pr1)))
  (:action ac5 :parameters () :precondition (and (pr1) (not (pr2)) (pr2)) :effect (and (pr2) (pr2)))
  (:action ac6 :parameters (?v0 - ty0) :precondition (and (pr1) (pr2)) :effect (oneof (and (pr1)) (and) (and (pr2))))
  (:action ac7 :parameters (?v0 - ty0 ?v1 - ty1) :effect (and (not (pr1))))
  (:method mt0 :parameters (?v0 - ty0) :task (tk0 ?v0) :ordered-subtasks (and (s0 (ac0 ?v0))))
  (:method mt1 :parameters (?v0 - ty0) :task (tk0 ?v0) :subtasks (and (s0 (ac5)) (s1 (ac5))) :ordering (and (< s0 s1)))
  (:method mt2 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac0 ?v0))))
)
