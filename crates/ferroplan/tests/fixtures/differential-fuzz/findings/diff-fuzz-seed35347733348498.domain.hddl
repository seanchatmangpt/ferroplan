;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0 ty1)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty0)
    (pr1 ?a0 - ty0 ?a1 - ty1)
    (pr2 ?a0 - ty1 ?a1 - ty1)
  )
  (:task tk0 :parameters (?v0 - ty1))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty1))
  (:task tk2 :parameters ())
  (:task tk3 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk4 :parameters (?v0 - ty0 ?v1 - ty1))
  (:action ac0 :parameters () :effect (and ))
  (:action ac1 :parameters (?v0 - ty0 ?v1 - ty1) :precondition (and (not (pr1 ?v0 ?v1)) (pr2 ?v1 ?v1)) :effect (oneof (and (pr1 ?v0 ?v1)) (and (pr2 ?v1 ?v1) (pr2 ?v1 ?v1)) (and (pr1 ?v0 ?v1)) (and (pr2 ?v1 ?v1) (pr1 ?v0 ?v1) (pr2 ?v1 ?v1))))
  (:action ac2 :parameters (?v0 - ty1) :effect (and (pr2 ?v0 ?v0) (pr2 ?v0 ?v0)))
  (:action ac3 :parameters (?v0 - ty1 ?v1 - ty1) :precondition (and (pr2 ?v1 ?v1) (pr2 ?v1 ?v0) (pr2 ?v1 ?v1)) :effect (oneof (and) (and)))
  (:action ac4 :parameters () :effect (and ))
  (:action ac5 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr0 ?v1 ?v1) (pr0 ?v0 ?v0) (pr0 ?v0 ?v1)) :effect (oneof (and) (and) (and)))
  (:method mt0 :parameters (?v0 - ty1) :task (tk0 ?v0) :subtasks (and (s0 (ac4))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac4))))
  (:method mt2 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk1 ?v0 ?v1) :precondition (and (pr2 ?v1 ?v1)) :ordered-subtasks (and (s0 (ac1 ?v0 ?v1))))
  (:method mt3 :parameters () :task (tk2) :subtasks (and (s0 (ac0))) :ordering (and ))
  (:method mt4 :parameters () :task (tk2) :subtasks (and (s0 (ac4))) :ordering (and ))
  (:method mt5 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk3 ?v0 ?v1) :subtasks (and (s0 (ac4))) :ordering (and ))
  (:method mt6 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk4 ?v0 ?v1) :ordered-subtasks (and (s0 (ac4))))
  (:method mt7 :parameters (?v0 - ty0 ?v1 - ty1) :task (tk4 ?v0 ?v1) :precondition (and (pr1 ?v0 ?v1) (pr0 ?v0 ?v0)) :ordered-subtasks (and (s0 (ac3 ?v1 ?v1)) (s1 (tk3 ?v0 ?v0))))
)
