;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty0)
    (pr1 ?a0 - ty0 ?a1 - ty0)
    (pr2)
  )
  (:task tk0 :parameters (?v0 - ty0))
  (:task tk1 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk2 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk3 :parameters (?v0 - ty0))
  (:task tk4 :parameters (?v0 - ty0 ?v1 - ty0))
  (:task tk5 :parameters (?v0 - ty0))
  (:action ac0 :parameters () :effect (oneof (and (pr2) (not (pr2))) (and (not (pr2)) (pr2)) (and (not (pr2))) (and (pr2) (pr2))))
  (:action ac1 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (not (pr0 ?v0 ?v1)) (pr1 ?v1 ?v1)) :effect (and (not (pr1 ?v1 ?v0)) (not (pr1 ?v1 ?v0)) (not (pr1 ?v1 ?v0))))
  (:action ac2 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr1 ?v0 ?v0)) :effect (and (not (pr0 ?v0 ?v1)) (pr0 ?v1 ?v0) (pr1 ?v0 ?v0)))
  (:action ac3 :parameters () :effect (oneof (and (pr2)) (and (pr2)) (and (pr2))))
  (:action ac4 :parameters (?v0 - ty0) :precondition (and (pr1 ?v0 ?v0) (not (pr2))) :effect (and (not (pr2)) (not (pr0 ?v0 ?v0))))
  (:action ac5 :parameters () :precondition (and (pr2) (pr2)) :effect (and (pr2) (pr2)))
  (:action ac6 :parameters () :effect (oneof (and) (and (pr2) (pr2)) (and)))
  (:action ac7 :parameters () :effect (and (pr2)))
  (:method mt0 :parameters (?v0 - ty0) :task (tk0 ?v0) :subtasks (and (s0 (ac0))) :ordering (and ))
  (:method mt1 :parameters (?v0 - ty0) :task (tk0 ?v0) :precondition (and (pr2) (pr1 ?v0 ?v0)) :subtasks (and (s0 (tk4 ?v0 ?v0)) (s1 (ac3))) :ordering (and (< s0 s1)))
  (:method mt2 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk1 ?v0 ?v1) :ordered-subtasks (and (s0 (ac7))))
  (:method mt3 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk2 ?v0 ?v1) :ordered-subtasks (and (s0 (ac7))))
  (:method mt4 :parameters (?v0 - ty0) :task (tk3 ?v0) :ordered-subtasks (and (s0 (ac0))))
  (:method mt5 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk4 ?v0 ?v1) :ordered-subtasks (and (s0 (ac6))))
  (:method mt6 :parameters (?v0 - ty0 ?v1 - ty0) :task (tk4 ?v0 ?v1) :precondition (and (not (pr0 ?v1 ?v0))) :ordered-subtasks (and (s0 (ac0))))
  (:method mt7 :parameters (?v0 - ty0) :task (tk5 ?v0) :ordered-subtasks (and (s0 (ac3))))
)
