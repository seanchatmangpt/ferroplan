;; differential-fuzz: self-authored seeded VALID draw (ticket fond-htn-61,
;; in-repo generator, no external corpus content)
(define (domain fzr)
  (:types ty0)
  (:predicates
    (pr0 ?a0 - ty0 ?a1 - ty0)
    (pr1)
  )
  (:task tk0 :parameters ())
  (:task tk1 :parameters (?v0 - ty0))
  (:action ac0 :parameters () :effect (and (pr1) (not (pr1))))
  (:action ac1 :parameters () :precondition (and (pr1)) :effect (and (not (pr1)) (pr1) (pr1)))
  (:action ac2 :parameters () :precondition (and (not (pr1))) :effect (and (pr1) (pr1)))
  (:action ac3 :parameters () :precondition (and (pr1) (not (pr1)) (not (pr1))) :effect (and (pr1) (not (pr1)) (not (pr1))))
  (:action ac4 :parameters (?v0 - ty0 ?v1 - ty0) :precondition (and (pr1) (pr0 ?v1 ?v1) (pr0 ?v0 ?v1)) :effect (and (pr1) (pr0 ?v1 ?v1) (not (pr1))))
  (:action ac5 :parameters (?v0 - ty0 ?v1 - ty0) :effect (and (pr1) (pr1) (not (pr0 ?v0 ?v0))))
  (:method mt0 :parameters () :task (tk0) :ordered-subtasks (and (s0 (ac0))))
  (:method mt1 :parameters () :task (tk0) :precondition (and (not (pr1))) :ordered-subtasks (and (s0 (ac2))))
  (:method mt2 :parameters (?v0 - ty0) :task (tk1 ?v0) :subtasks (and (s0 (ac5 ?v0 ?v0))) :ordering (and ))
  (:method mt3 :parameters (?v0 - ty0) :task (tk1 ?v0) :precondition (and (pr1) (pr0 ?v0 ?v0)) :subtasks (and (s0 (ac1)) (s1 (ac5 ?v0 ?v0))) :ordering (and (< s0 s1)))
)
