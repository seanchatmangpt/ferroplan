;; hand-authored, childsnack-pattern (ticket fond-htn-12)
(define (domain tray-dirty)
  (:predicates (clean) (dirty) (grubby) (served))
  (:task meal :parameters ())
  (:task serve :parameters ())
  (:action place :parameters () :precondition (and (clean))
    :effect (oneof (and (not (clean)) (dirty)) (and (not (clean)) (grubby))))
  (:action wash :parameters () :precondition (and (dirty))
    :effect (and (not (dirty)) (clean)))
  (:action scrub :parameters () :precondition (and (grubby))
    :effect (and (not (grubby)) (clean)))
  (:action do-serve :parameters () :precondition (and (clean))
    :effect (and (served)))
  (:method m-meal :parameters () :task (meal)
    :precondition (and)
    :ordered-subtasks (and (t1 (place)) (t2 (serve))))
  (:method serve-clean :parameters () :task (serve)
    :precondition (and (clean)) :ordered-subtasks (and (s1 (do-serve))))
  (:method serve-dirty :parameters () :task (serve)
    :precondition (and (dirty)) :ordered-subtasks (and (s1 (wash)) (s2 (serve))))
  (:method serve-grubby :parameters () :task (serve)
    :precondition (and (grubby)) :ordered-subtasks (and (s1 (scrub)) (s2 (serve)))))
