;; hand-authored, snake-pattern (ticket fond-htn-12)
(define (domain grow-loop)
  (:predicates (stage1) (full))
  (:task build :parameters ())
  (:method grow :parameters () :task (build)
    :precondition (and (not (full)))
    :ordered-subtasks (and (g1 (add-block)) (g2 (build))))
  (:method stop :parameters () :task (build)
    :precondition (and (full)) :ordered-subtasks (and))
  (:action add-block :parameters () :precondition (and (stage1))
    :effect (and (not (stage1)) (full))))
