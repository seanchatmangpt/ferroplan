;; hand-authored, satellite-pattern (ticket fond-htn-12)
(define (domain sense-branch)
  (:predicates (mode-fast) (mode-slow) (scanned))
  (:task mission :parameters ())
  (:task operate :parameters ())
  (:action sense-mode :parameters () :precondition (and)
    :effect (oneof (and (mode-fast)) (and (mode-slow))))
  (:action fast-scan :parameters () :precondition (and (mode-fast))
    :effect (and (scanned)))
  (:action slow-scan :parameters () :precondition (and (mode-slow))
    :effect (and (scanned)))
  (:method m-mission :parameters () :task (mission)
    :precondition (and)
    :ordered-subtasks (and (t1 (sense-mode)) (t2 (operate))))
  (:method op-fast :parameters () :task (operate)
    :precondition (and (mode-fast)) :ordered-subtasks (and (o1 (fast-scan))))
  (:method op-slow :parameters () :task (operate)
    :precondition (and (mode-slow)) :ordered-subtasks (and (o1 (slow-scan)))))
