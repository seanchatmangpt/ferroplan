;; hand-authored, deterministic-baseline (ticket fond-htn-12)
(define (domain plain-chain)
  (:predicates (at-a) (at-b) (at-c) (at-d))
  (:task travel :parameters ())
  (:action step-ab :parameters () :precondition (and (at-a))
    :effect (and (not (at-a)) (at-b)))
  (:action step-bc :parameters () :precondition (and (at-b))
    :effect (and (not (at-b)) (at-c)))
  (:action step-cd :parameters () :precondition (and (at-c))
    :effect (and (not (at-c)) (at-d)))
  (:method m-travel :parameters () :task (travel)
    :precondition (and)
    :ordered-subtasks (and (t1 (step-ab)) (t2 (step-bc)) (t3 (step-cd)))))
