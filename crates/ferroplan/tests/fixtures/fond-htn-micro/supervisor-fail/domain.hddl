;; hand-authored, depots-pattern (ticket fond-htn-12)
(define (domain supervisor-fail)
  (:predicates (ready) (shipped) (failed) (done))
  (:task ship :parameters ())
  (:task finish :parameters ())
  (:action attempt :parameters () :precondition (and (ready))
    :effect (oneof (and (not (ready)) (shipped)) (and (not (ready)) (failed))))
  (:action close :parameters () :precondition (and (shipped))
    :effect (and (done)))
  (:action reset :parameters () :precondition (and (failed))
    :effect (and (not (failed)) (ready)))
  (:method ship-now :parameters () :task (ship)
    :precondition (and)
    :ordered-subtasks (and (t1 (attempt)) (t2 (finish))))
  (:method finish-ok :parameters () :task (finish)
    :precondition (and (shipped)) :ordered-subtasks (and (f1 (close))))
  (:method finish-retry :parameters () :task (finish)
    :precondition (and (failed))
    :ordered-subtasks (and (f1 (reset)) (f2 (ship)))))
