;; hand-authored adversarial fixture (ticket fond-htn-14) — not derived from any corpus.
;; Method subtask calls 'warp', which is neither a declared task nor action.
(define (domain unknown-subtask)
  (:predicates (at ?x))
  (:task travel
    :parameters (?x))
  (:method m-travel
    :parameters (?x)
    :task (travel ?x)
    :subtasks (and (s1 (warp ?x)))))
