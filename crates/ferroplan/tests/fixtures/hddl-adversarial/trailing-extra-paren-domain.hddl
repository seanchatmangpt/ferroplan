;; hand-authored adversarial fixture (ticket fond-htn-14) — not derived from any corpus.
;; The stray ')' only AFTER the top-level form: read_top discards trailing
;; tokens, so this is currently accepted silently — asserted as an explicit
;; documented-tolerance case in hddl_adversarial.rs.
(define (domain trailing-extra)
  (:predicates (at ?x))
  (:action move
    :parameters (?x)
    :precondition ()
    :effect (at ?x))))
