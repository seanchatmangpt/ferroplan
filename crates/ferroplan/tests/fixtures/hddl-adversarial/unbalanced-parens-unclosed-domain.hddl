;; hand-authored adversarial fixture (ticket fond-htn-14) — not derived from any corpus.
;; Missing the final ')' of the top-level (define ...) form.
(define (domain unbalanced-unclosed)
  (:predicates (at ?x))
  (:action move
    :parameters (?x)
    :precondition (at ?x)
    :effect (and (not (at ?x))))
