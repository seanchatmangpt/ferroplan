;; hand-authored adversarial fixture (ticket fond-htn-14) — not derived from any corpus.
;; The method's ':task' call passes 1 argument to the 2-parameter task.
(define (domain arity-method)
  (:predicates (at ?x))
  (:task travel
    :parameters (?x ?y))
  (:method m-travel
    :parameters (?x)
    :task (travel ?x)
    :subtasks (and)))
