;; hand-authored adversarial fixture (ticket fond-htn-14) — not derived from any corpus.
;; Cyclic ordering: s1 < s2 < s1 — no topological start.
(define (domain order-cyclic)
  (:predicates (at ?x))
  (:action move
    :parameters (?x)
    :precondition ()
    :effect (at ?x))
  (:task travel
    :parameters (?x))
  (:method m-travel
    :parameters (?x)
    :task (travel ?x)
    :subtasks (and (s1 (move ?x)) (s2 (move ?x)))
    :ordering (and (s1 < s2) (s2 < s1))))
