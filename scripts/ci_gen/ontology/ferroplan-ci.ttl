# Consumer facts for github-actions-pack: ferroplan phase-1 workflow set (R4).
# SOURCE OF TRUTH for .github/workflows/{ci,planning-runtime,ecosystem-alive-format-closure,
# daily-agent-methods,ferroplan-harvester}.yml. Generated by ggen; edit here, re-run ggen sync.

fci:wf_ci a gha:Workflow ;
  gha:fileName """ci.yml""" ;
  gha:purpose """CI""" ;
  gha:onBlock """pull_request:
push:
  branches: [main]
workflow_dispatch:""" ;
  gha:trigger gha:EventPush, gha:EventPullRequest, gha:EventWorkflowDispatch ;
  gha:concurrencyPolicy """group: ci-${{ github.event.pull_request.number || github.ref }}
cancel-in-progress: true""" ;
  gha:permissionCeiling """contents: read""" ;
  gha:workflowEnv """CARGO_TERM_COLOR: always""" ;
  gha:workflowEnv """RUSTC_WRAPPER: "\"""" .

fci:job_ci_classify a gha:Job ;
  gha:inWorkflow fci:wf_ci ;
  gha:jobName """classify""" ;
  gha:runner """ubuntu-24.04""" ;
  gha:timeoutMinutes 3
  ; gha:jobExtra """name: Route owned evidence
outputs:
  rust: ${{ steps.route.outputs.rust }}
  plugin: ${{ steps.route.outputs.plugin }}"""
  .

fci:job_ci_classify_s01 a gha:Step ;
  gha:inJob fci:job_ci_classify ;
  gha:stepOrder 1 ;
  gha:usesAction """actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2""" ;
  gha:withParam """ref: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """fetch-depth: 0""" ;
  gha:withParam """persist-credentials: false""" .

fci:job_ci_classify_s02 a gha:Step ;
  gha:inJob fci:job_ci_classify ;
  gha:stepOrder 2 ;
  gha:stepId """subject""" ;
  gha:envVar """PR_BASE: ${{ github.event.pull_request.base.sha }}""" ;
  gha:runCommand """base="${PR_BASE:-$(git rev-parse HEAD^)}"
echo "base=$base" >> "$GITHUB_OUTPUT\"""" .

fci:job_ci_classify_s03 a gha:Step ;
  gha:inJob fci:job_ci_classify ;
  gha:stepOrder 3 ;
  gha:stepId """route""" ;
  gha:runCommand """python3 scripts/ci_router.py --base '${{ steps.subject.outputs.base }}' --head '${{ github.event.pull_request.head.sha || github.sha }}' --report target/ci/ci-route.json""" .

fci:job_ci_rust_core a gha:Job ;
  gha:inWorkflow fci:wf_ci ;
  gha:jobName """rust-core""" ;
  gha:runner """ubuntu-24.04""" ;
  gha:timeoutMinutes 45
  ; gha:dependsOn fci:job_ci_classify
  ; gha:condition """needs.classify.outputs.rust == 'true'"""
  ; gha:jobExtra """name: Rust core deep lane"""
  .

fci:job_ci_rust_core_s01 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 1 ;
  gha:usesAction """actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2""" ;
  gha:withParam """ref: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """persist-credentials: false""" .

fci:job_ci_rust_core_s02 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 2 ;
  gha:usesAction """dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c""" ;
  gha:withParam """toolchain: stable""" ;
  gha:withParam """components: rustfmt, clippy""" .

fci:job_ci_rust_core_s03 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 3 ;
  gha:stepName """Format""" ;
  gha:runCommand """cargo fmt --all -- --check""" .

fci:job_ci_rust_core_s04 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 4 ;
  gha:stepName """Clippy owned native workspace""" ;
  gha:runCommand """cargo clippy --workspace --exclude ferroplan-bevy --all-targets --all-features -- -D warnings""" .

fci:job_ci_rust_core_s05 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 5 ;
  gha:stepName """Test owned native workspace""" ;
  gha:runCommand """cargo test --workspace --exclude ferroplan-bevy""" .

fci:job_ci_rust_core_s06 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 6 ;
  gha:stepName """Heavy IPC regression guards""" ;
  gha:runCommand """cargo test --release -p ferroplan -- --ignored""" .

fci:job_ci_rust_core_s07 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 7 ;
  gha:stepName """Documentation and benchmark compile""" ;
  gha:runCommand """RUSTDOCFLAGS='-D warnings' cargo doc --no-deps --all-features --workspace --exclude ferroplan-bevy
cargo bench --no-run -p ferroplan""" .

fci:job_ci_rust_core_s08 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 8 ;
  gha:stepName """Drift gates""" ;
  gha:runCommand """python3 scripts/drift_gates.py""" .

fci:job_ci_rust_core_s09 a gha:Step ;
  gha:inJob fci:job_ci_rust_core ;
  gha:stepOrder 9 ;
  gha:stepName """Generator drift (needs ggen + sibling packs)""" ;
  gha:runCommand """# ggen and the ../ggen-marketplace packs are path dependencies that a clean runner does not have.
# Present: both gates run and fail on drift. Absent: skipped with a notice; the cargo drift tests above still run.
if command -v ggen >/dev/null 2>&1 && [ -d ../ggen-marketplace/packs ]; then
  scripts/ci_gen.sh --check
  cargo install just --locked
  just wasm-gen-check
else
  echo "::notice::ggen or ../ggen-marketplace unavailable; skipping ci_gen --check and wasm-gen-check"
fi""" .

fci:job_ci_wasm_pin a gha:Job ;
  gha:inWorkflow fci:wf_ci ;
  gha:jobName """wasm-pin""" ;
  gha:runner """ubuntu-24.04""" ;
  gha:timeoutMinutes 30
  ; gha:dependsOn fci:job_ci_classify
  ; gha:condition """needs.classify.outputs.rust == 'true'"""
  ; gha:jobExtra """name: WASM artifact pin
continue-on-error: true  # advisory until the first green run on a stock runner"""
  .

fci:job_ci_wasm_pin_s01 a gha:Step ;
  gha:inJob fci:job_ci_wasm_pin ;
