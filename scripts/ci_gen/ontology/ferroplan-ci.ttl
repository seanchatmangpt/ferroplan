just wasm-build-pin""" .

fci:job_ci_plugin a gha:Job ;
  gha:inWorkflow fci:wf_ci ;
  gha:jobName """plugin""" ;
  gha:runner """ubuntu-24.04""" ;
  gha:timeoutMinutes 25
  ; gha:dependsOn fci:job_ci_classify
