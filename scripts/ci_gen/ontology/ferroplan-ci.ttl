  gha:stepOrder 7 ;
  gha:stepName """Upload plugin receipts""" ;
  gha:condition """always()""" ;
  gha:usesAction """actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02""" ;
  gha:withParam """name: plugin-evidence-${{ github.event.pull_request.head.sha || github.sha }}""" ;
