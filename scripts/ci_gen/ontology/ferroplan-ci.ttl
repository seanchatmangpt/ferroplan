  gha:stepName """Install verifier tooling""" ;
  gha:runCommand """pip install --quiet pytest ruff coverage typer pydantic jsonschema rdflib pyshacl""" .

fci:job_ci_plugin_s04 a gha:Step ;
  gha:inJob fci:job_ci_plugin ;
  gha:stepOrder 4 ;
  gha:stepName """Static and generated projection checks""" ;
  gha:runCommand """ruff check scripts tests
python -m compileall -q scripts
for f in scripts/*.sh; do sh -n "$f"; done
python scripts/generate.py build --check""" .

fci:job_ci_plugin_s05 a gha:Step ;
  gha:inJob fci:job_ci_plugin ;
