fci:wf_planning a gha:Workflow ;
  gha:fileName """planning-runtime.yml""" ;
  gha:purpose """Planning Runtime Crown""" ;
  gha:onBlock """pull_request:
  paths:
    - "crates/ferroplan/src/planning_runtime.rs"
    - "crates/ferroplan/src/planning_types.rs"
    - "crates/ferroplan/src/lib.rs"
    - "crates/ferroplan/tests/planning_runtime.rs"
    - "crates/ferroplan/tests/planning_types.rs"
    - "crates/ferroplan/tests/mfw_python_oracle.rs"
    - "scripts/verify_mfw_planning_capsule.py"
    - "vendor/mfw-planning-autonomic/**"
    - ".autonomic/planning-runtime.lifecycle.json"
    - ".github/workflows/planning-runtime.yml"
workflow_dispatch:""" ;
  gha:trigger gha:EventPullRequest, gha:EventWorkflowDispatch ;
  gha:concurrencyPolicy """group: planning-runtime-${{ github.event.pull_request.number || github.ref }}
cancel-in-progress: true""" ;
  gha:permissionCeiling """contents: read""" ;
  gha:noPushTriggerReason """PR-path-filtered evidence lane plus manual dispatch; mirrors hand-written trigger set (no push trigger in original)""" ;
  gha:workflowEnv """RUSTC_WRAPPER: "\"""" ;
  gha:workflowEnv """FERROPLAN_REQUIRE_MFW_ORACLE: "1\"""" ;
  gha:workflowEnv """MFW_PLANNER_ORACLE_PYTHONPATH: ${{ github.workspace }}/vendor/mfw-planning-autonomic/oracle""" ;
  gha:workflowEnv """PYTHONPATH: ${{ github.workspace }}/vendor/mfw-planning-autonomic/oracle:${{ github.workspace }}/vendor/mfw-planning-autonomic/lifecycle""" .

fci:job_planning_planning_runtime a gha:Job ;
  gha:inWorkflow fci:wf_planning ;
  gha:jobName """planning-runtime""" ;
  gha:runner """macos-14""" ;
  gha:timeoutMinutes 40
  .

fci:job_planning_planning_runtime_s01 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 1 ;
  gha:stepName """Checkout exact Ferroplan head""" ;
  gha:usesAction """actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2""" ;
  gha:withParam """ref: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """fetch-depth: 0""" ;
  gha:withParam """persist-credentials: false""" .

fci:job_planning_planning_runtime_s02 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 2 ;
  gha:stepName """Assert exact head identity""" ;
  gha:envVar """EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:runCommand """test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD" || exit 42""" .

fci:job_planning_planning_runtime_s03 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 3 ;
  gha:usesAction """actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065""" ;
  gha:withParam """python-version: "3.11\"""" .

fci:job_planning_planning_runtime_s04 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 4 ;
  gha:stepName """Install stable Rust""" ;
  gha:runCommand """rustup toolchain install stable --profile minimal --component rustfmt,clippy""" .

fci:job_planning_planning_runtime_s05 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 5 ;
  gha:stepName """Compile projected MFW capsule""" ;
  gha:runCommand """python3 -m compileall -q \\
  vendor/mfw-planning-autonomic/oracle \\
  vendor/mfw-planning-autonomic/lifecycle \\
  scripts/verify_mfw_planning_capsule.py""" .

fci:job_planning_planning_runtime_s06 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 6 ;
  gha:stepName """Verify MFW source authority capsule""" ;
  gha:runCommand """python3 scripts/verify_mfw_planning_capsule.py > mfw-planning-capsule.verification.json""" .

fci:job_planning_planning_runtime_s07 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 7 ;
  gha:stepName """Execute complete autonomic planning lifecycle""" ;
  gha:runCommand """python3 -m mfw_autonomic_lifecycle check .autonomic/planning-runtime.lifecycle.json
python3 -m mfw_autonomic_lifecycle run \\
  .autonomic/planning-runtime.lifecycle.json \\
  --receipt planning-runtime-lifecycle.receipt.json""" .

fci:job_planning_planning_runtime_s08 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 8 ;
  gha:stepName """Replay complete read-only lifecycle""" ;
  gha:runCommand """python3 -m mfw_autonomic_lifecycle replay \\
  .autonomic/planning-runtime.lifecycle.json \\
  planning-runtime-lifecycle.receipt.json \\
  > planning-runtime-lifecycle.replay.json""" .

fci:job_planning_planning_runtime_s09 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 9 ;
  gha:stepName """Assert terminal ALIVE standing""" ;
  gha:runCommand """python3 - <<'PY'
import json
from pathlib import Path
source = json.loads(Path('vendor/mfw-planning-autonomic/SOURCE.json').read_text())
verification = json.loads(Path('mfw-planning-capsule.verification.json').read_text())
lifecycle = json.loads(Path('planning-runtime-lifecycle.receipt.json').read_text())
replay = json.loads(Path('planning-runtime-lifecycle.replay.json').read_text())
assert source['producer']['commit'] == 'df511b2dd6aec591d49bf25f652d46a2d03fc3d1'
assert verification['standing'] == 'ALIVE'
assert lifecycle['standing'] == 'ALIVE'
assert lifecycle['wip_limit'] == 1
assert replay['standing'] == 'ALIVE'
assert replay['agreement'] is True
PY""" .

fci:job_planning_planning_runtime_s10 a gha:Step ;
  gha:inJob fci:job_planning_planning_runtime ;
  gha:stepOrder 10 ;
  gha:stepName """Upload lifecycle receipts""" ;
  gha:condition """always()""" ;
  gha:usesAction """actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02""" ;
  gha:withParam """name: planning-runtime-lifecycle-receipts-${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """path: |
            vendor/mfw-planning-autonomic/SOURCE.json
            mfw-planning-capsule.verification.json
            planning-runtime-lifecycle.receipt.json
            planning-runtime-lifecycle.replay.json""" ;
  gha:withParam """if-no-files-found: warn""" ;
  gha:withParam """retention-days: 30""" .

