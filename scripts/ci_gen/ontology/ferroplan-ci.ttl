  gha:withParam """components: rustfmt""" .

fci:job_daily_ppddl_corpus_s03 a gha:Step ;
  gha:inJob fci:job_daily_ppddl_corpus ;
  gha:stepOrder 3 ;
  gha:usesAction """Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2""" .

fci:job_daily_ppddl_corpus_s04 a gha:Step ;
  gha:inJob fci:job_daily_ppddl_corpus ;
  gha:stepOrder 4 ;
  gha:stepName """Format owned Rust surface""" ;
  gha:runCommand """rustfmt --edition 2021 --check crates/ferroplan/tests/daily_agent_methods_ppddl.rs""" .

fci:job_daily_ppddl_corpus_s05 a gha:Step ;
  gha:inJob fci:job_daily_ppddl_corpus ;
  gha:stepOrder 5 ;
  gha:stepName """Parse evidence catalog""" ;
  gha:runCommand """python3 -m json.tool examples/daily_agent_methods/method-catalog.json >/dev/null""" .

fci:job_daily_ppddl_corpus_s06 a gha:Step ;
  gha:inJob fci:job_daily_ppddl_corpus ;
  gha:stepOrder 6 ;
  gha:stepName """Execute PPDDL admission and refusal tests""" ;
  gha:runCommand """cargo test -p ferroplan --test daily_agent_methods_ppddl""" .

fci:wf_harvester a gha:Workflow ;
  gha:fileName """ferroplan-harvester.yml""" ;
  gha:purpose """Ferroplan Evidence Harvester""" ;
  gha:onBlock """pull_request:
  paths:
    - 'Cargo.lock'
    - 'crates/ferroplan/**'
    - 'crates/ferroplan-cli/**'
    - 'crates/ferroplan-mcp/**'
    - 'plugins/chatman-ecosystem/**'
    - '.github/workflows/ferroplan-harvester.yml'
workflow_dispatch:""" ;
  gha:trigger gha:EventPullRequest, gha:EventWorkflowDispatch ;
  gha:concurrencyPolicy """group: ferroplan-harvester-${{ github.event.pull_request.number || github.ref }}
cancel-in-progress: true""" ;
  gha:permissionCeiling """contents: read
  actions: read""" ;
  gha:noPushTriggerReason """PR-path-filtered evidence lane plus manual dispatch; mirrors hand-written trigger set (no push trigger in original)""" ;
  gha:workflowEnv """RUSTC_WRAPPER: ''""" .

fci:job_harvester_harvest_boundary a gha:Job ;
  gha:inWorkflow fci:wf_harvester ;
  gha:jobName """harvest-boundary""" ;
  gha:runner """ubuntu-22.04""" ;
  gha:timeoutMinutes 60
  ; gha:jobExtra """name: Receipt and replay deep lane"""
  .

fci:job_harvester_harvest_boundary_s01 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 1 ;
  gha:stepName """Checkout exact candidate""" ;
  gha:usesAction """actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2""" ;
  gha:withParam """ref: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """fetch-depth: 0""" ;
  gha:withParam """persist-credentials: false""" .

fci:job_harvester_harvest_boundary_s02 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 2 ;
  gha:stepName """Assert exact head identity""" ;
  gha:envVar """EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:runCommand """test "$(git rev-parse HEAD)" = "$EXPECTED_HEAD" || exit 42""" .

fci:job_harvester_harvest_boundary_s03 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 3 ;
  gha:stepName """Install Rust admission toolchain""" ;
  gha:runCommand """rustup toolchain install stable --profile minimal --component rustfmt,clippy""" .

fci:job_harvester_harvest_boundary_s04 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 4 ;
  gha:stepName """Install Python verifier toolchain""" ;
  gha:usesAction """actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065""" ;
  gha:withParam """python-version: '3.11'""" .

fci:job_harvester_harvest_boundary_s05 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 5 ;
  gha:stepName """Install verifier dependencies""" ;
  gha:runCommand """pip install --quiet pytest ruff coverage typer pydantic jsonschema rdflib pyshacl""" .

fci:job_harvester_harvest_boundary_s06 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 6 ;
  gha:stepName """Refuse dirty source before manufacture""" ;
  gha:runCommand """cargo fmt --all -- --check
git diff --exit-code""" .

fci:job_harvester_harvest_boundary_s07 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 7 ;
  gha:stepName """Execute Rust admission boundaries""" ;
  gha:runCommand """cargo check -p ferroplan-cli --bin ferroplan-harvest --tests
cargo check -p ferroplan-mcp --bins --tests
cargo test -p ferroplan-cli --test harvest
cargo test -p ferroplan-mcp --test admission_protocol
cargo test -p ferroplan-mcp --test session_protocol
cargo test -p ferroplan-mcp --test session
cargo test -p ferroplan-mcp --test session_control
cargo test -p ferroplan-mcp --test experience_plane
cargo test -p ferroplan-mcp --test merged_server
cargo test -p ferroplan-mcp --test protocol
cargo test -p ferroplan-mcp --bin ferroplan-mcp-plus
cargo test -p ferroplan --test fortune5_capabilities
cargo test -p ferroplan --test fortune5_explain_parallel""" .

fci:job_harvester_harvest_boundary_s08 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 8 ;
  gha:stepName """Execute plugin control plane""" ;
  gha:runCommand """cd plugins/chatman-ecosystem
ruff check scripts tests
python -m compileall -q scripts
for f in scripts/*.sh; do sh -n "$f"; done
python scripts/validate-claude-projection.py --plugin-root .
python scripts/generate.py build --check
pytest""" .

fci:job_harvester_harvest_boundary_s09 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 9 ;
  gha:stepName """Execute closed-window live GitHub harvest""" ;
  gha:envVar """GH_TOKEN: ${{ github.token }}""" ;
  gha:runCommand """rm -rf target/live-harvest
cargo run -p ferroplan-cli --bin ferroplan-harvest -- run --repo seanchatmangpt/ferroplan --since 2026-07-31T07:00:00Z --until 2026-08-01T07:00:00Z --timezone America/Los_Angeles --max-pages 10 --output-dir target/live-harvest
python3 - <<'PY'
import json
from pathlib import Path
receipt = json.loads(Path('target/live-harvest/receipt.json').read_text())
if receipt['final_state'] not in {'PARTIAL_ALIVE', 'ALIVE'}:
    raise SystemExit(f"LIVE_HARVEST_NOT_ADMITTED: {receipt['final_state']}")
if not receipt['admitted_work']:
    raise SystemExit('LIVE_HARVEST_EMPTY_ADMISSION')
PY""" .

fci:job_harvester_harvest_boundary_s10 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 10 ;
  gha:stepName """Refuse uncommitted manufacture""" ;
  gha:runCommand """git diff --exit-code""" .

fci:job_harvester_harvest_boundary_s11 a gha:Step ;
  gha:inJob fci:job_harvester_harvest_boundary ;
  gha:stepOrder 11 ;
  gha:stepName """Upload complete receipts""" ;
  gha:condition """always()""" ;
  gha:usesAction """actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02""" ;
  gha:withParam """name: ferroplan-complete-receipts-${{ github.event.pull_request.head.sha || github.sha }}""" ;
  gha:withParam """path: target/live-harvest""" ;
  gha:withParam """if-no-files-found: warn""" ;
  gha:withParam """retention-days: 30""" .

