fci:job_ci_plugin_s06 a gha:Step ;
  gha:inJob fci:job_ci_plugin ;
  gha:stepOrder 6 ;
  gha:stepName """Focused Luna evidence""" ;
  gha:envVar """PYTEST_DISABLE_PLUGIN_AUTOLOAD: '1'""" ;
  gha:runCommand """python -m pytest -q --junitxml=openai-luna-junit.xml tests/test_openai_luna*.py tests/test_openai_ostar_star.py
coverage run --branch --source=mcp_client,openai_luna_protocol,openai_luna_runtime,openai_ostar_star,verify_openai_luna -m pytest -q tests/test_openai_luna_unit.py tests/test_openai_luna_contract.py tests/test_openai_luna_property.py tests/test_openai_luna_replay.py tests/test_openai_luna_mutation.py tests/test_openai_luna_security.py tests/test_openai_luna_integration.py tests/test_openai_luna_chaos.py tests/test_openai_luna_verifier.py tests/test_openai_ostar_star.py
coverage report --fail-under=75
coverage xml -o openai-luna-coverage.xml
python scripts/verify_openai_luna.py --junit openai-luna-junit.xml --output openai-luna-verifier.json --python-version '3.11' --static-check ruff --static-check compileall --static-check shell-syntax --static-check coverage""" .

