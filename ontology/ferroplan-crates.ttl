# ferroplan-crates.ttl -- crate roster: one individual per crates/<name> directory.
# Source of truth for the README "Workspace layout" region and book/src/crates.md.
# Gate: ontology/ferroplan-crates.gate.py fails when a crates/* directory has no
# individual here, or when the README region / book chapter drift from the projection.
# fpc:publish mirrors the cargo publish set (ferroplan-sat, -hddl, ferroplan, -cli, -mcp; Cargo.toml publish = false elsewhere).
# fpc:repoBase is the single repo URL datum used in rendered links (origin remote).

@prefix fpc: <http://ferroplan.io/crates#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fpc:workspace a fpc:Workspace ;
    fpc:repoBase "https://github.com/seanchatmangpt/ferroplan" .

fpc:ferroplan a fpc:Crate ;
    rdfs:label "ferroplan" ;
    fpc:crateName "ferroplan" ;
    fpc:order 1 ;
    fpc:kind "library" ;
    fpc:publish "yes" ;
    fpc:role "the library: engine + modes + `solve` / `decompose` / `Session` API" .

fpc:ferroplan_cli a fpc:Crate ;
    rdfs:label "ferroplan-cli" ;
    fpc:crateName "ferroplan-cli" ;
    fpc:order 2 ;
    fpc:kind "binary" ;
    fpc:publish "yes" ;
    fpc:role "the `ff` binary (clap + JSON)" .

fpc:ferroplan_mcp a fpc:Crate ;
    rdfs:label "ferroplan-mcp" ;
    fpc:crateName "ferroplan-mcp" ;
    fpc:order 3 ;
    fpc:kind "binary" ;
    fpc:publish "yes" ;
    fpc:role "an MCP server exposing `solve` / `validate` / `decompose` over stdio — so an LLM agent can author PDDL and drive the planner" .

fpc:ferroplan_bevy a fpc:Crate ;
    rdfs:label "ferroplan-bevy" ;
    fpc:crateName "ferroplan-bevy" ;
    fpc:order 4 ;
    fpc:kind "binary" ;
    fpc:publish "no" ;
    fpc:role "Bevy app: visualize, inspect & animate a domain+problem (`cargo run -p ferroplan-bevy [domain.pddl problem.pddl]`)" .

fpc:ferroplan_wasm a fpc:Crate ;
    rdfs:label "ferroplan-wasm" ;
    fpc:crateName "ferroplan-wasm" ;
    fpc:order 5 ;
    fpc:kind "binding" ;
    fpc:publish "no" ;
    fpc:role "WebAssembly binding behind the client-side [browser demo](https://seanchatmangpt.github.io/ferroplan/demo/index.html) — `solve` a domain+problem entirely in-page" .

fpc:ferroplan_py a fpc:Crate ;
    rdfs:label "ferroplan-py" ;
    fpc:crateName "ferroplan-py" ;
    fpc:order 6 ;
    fpc:kind "binding" ;
    fpc:publish "no" ;
    fpc:role "Python binding (`pip`-installable extension module) exposing `solve` for embedding in Python tools" .

fpc:ferroplan_hddl a fpc:Crate ;
    rdfs:label "ferroplan-hddl" ;
    fpc:crateName "ferroplan-hddl" ;
    fpc:order 7 ;
    fpc:kind "library" ;
    fpc:publish "yes" ;
    fpc:role "HDDL front-end: parses typed HDDL domain/problem text with `oneof` effects, grounds it and translates it into the ground IR the FOND solver runs over" .

fpc:ferroplan_sat a fpc:Crate ;
    rdfs:label "ferroplan-sat" ;
    fpc:crateName "ferroplan-sat" ;
    fpc:order 8 ;
    fpc:kind "library" ;
    fpc:publish "yes" ;
    fpc:role "in-tree CDCL SAT solver, absorbed from varisat 0.2.2 and carried forward as ferroplan code" .

fpc:ferroplan_runtime a fpc:Crate ;
    rdfs:label "ferroplan-runtime" ;
    fpc:crateName "ferroplan-runtime" ;
    fpc:order 9 ;
    fpc:kind "library" ;
    fpc:publish "no" ;
    fpc:role "runtime substrate: authority, budgets, circuit breakers and dispatch for hosting the planner (in-workspace, not published)" .
