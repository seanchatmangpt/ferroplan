fpw:err-fp-adapter a wja:ErrorCode ; wja:codeName "FP_ADAPTER" ; wja:codeOrder 1 .
fpw:err-fp-unknown-op a wja:ErrorCode ; wja:codeName "FP_UNKNOWN_OP" ; wja:codeOrder 2 .
fpw:err-fp-limit-input a wja:ErrorCode ; wja:codeName "FP_LIMIT_INPUT" ; wja:codeOrder 3 .
fpw:err-fp-invalid-request a wja:ErrorCode ; wja:codeName "FP_INVALID_REQUEST" ; wja:codeOrder 4 .
fpw:err-fp-invalid-problem a wja:ErrorCode ; wja:codeName "FP_INVALID_PROBLEM" ; wja:codeOrder 5 .
fpw:err-fp-invalid-policy a wja:ErrorCode ; wja:codeName "FP_INVALID_POLICY" ; wja:codeOrder 6 .
fpw:err-fp-validation a wja:ErrorCode ; wja:codeName "FP_VALIDATION" ; wja:codeOrder 7 .
fpw:err-fp-invariant a wja:ErrorCode ; wja:codeName "FP_INVARIANT" ; wja:codeOrder 8 .
fpw:err-fp-limit-search a wja:ErrorCode ; wja:codeName "FP_LIMIT_SEARCH" ; wja:codeOrder 9 .
fpw:err-fp-limit-memory a wja:ErrorCode ; wja:codeName "FP_LIMIT_MEMORY" ; wja:codeOrder 10 .
fpw:err-fp-limit-candidates a wja:ErrorCode ; wja:codeName "FP_LIMIT_CANDIDATES" ; wja:codeOrder 11 .
fpw:err-fp-limit-candidate a wja:ErrorCode ; wja:codeName "FP_LIMIT_CANDIDATE" ; wja:codeOrder 12 .
fpw:err-fp-duplicate-candidate a wja:ErrorCode ; wja:codeName "FP_DUPLICATE_CANDIDATE" ; wja:codeOrder 13 .
fpw:err-fp-parse a wja:ErrorCode ; wja:codeName "FP_PARSE" ; wja:codeOrder 14 .
fpw:err-fp-hddl-ground a wja:ErrorCode ; wja:codeName "FP_HDDL_GROUND" ; wja:codeOrder 15 .
fpw:err-fp-hddl-translate a wja:ErrorCode ; wja:codeName "FP_HDDL_TRANSLATE" ; wja:codeOrder 16 .
fpw:err-fp-hddl-root-mismatch a wja:ErrorCode ; wja:codeName "FP_HDDL_ROOT_MISMATCH" ; wja:codeOrder 17 .
fpw:err-fp-model a wja:ErrorCode ; wja:codeName "FP_MODEL" ; wja:codeOrder 18 .
fpw:err-fp-timeout a wja:ErrorCode ; wja:codeName "FP_TIMEOUT" ; wja:codeOrder 19 .
fpw:err-fp-worker-panicked a wja:ErrorCode ; wja:codeName "FP_WORKER_PANICKED" ; wja:codeOrder 20 .

fpw:imp-random-get a wja:WasiImport ; wja:importModule "wasi_snapshot_preview1" ; wja:importName "random_get" .
fpw:imp-environ-get a wja:WasiImport ; wja:importModule "wasi_snapshot_preview1" ; wja:importName "environ_get" .
