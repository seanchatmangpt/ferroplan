    wja:exampleRequest "{\"op\":\"session_probe\",\"handle\":1,\"candidates\":[{\"id\":\"c1\",\"goal\":\"(b)\",\"sight\":[[\"A\",true]]}],\"evals\":100000,\"mem_mb\":256}" .

