    wja:opName "session_replan_following" ;
    wja:opOrder 18 ;
    wja:requestFields "op,handle,evals,mem_mb" ;
    wja:responseFields "solved,mode,plan,statistics,notes" ;
    wja:exampleRequest "{\"op\":\"session_replan_following\",\"handle\":1,\"evals\":100000,\"mem_mb\":256}" .

