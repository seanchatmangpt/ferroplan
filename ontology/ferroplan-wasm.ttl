    wja:opName "session_repair" ;
    wja:opOrder 19 ;
    wja:requestFields "op,handle,evals,mem_mb" ;
    wja:responseFields "decision,trigger,plan_valid,previous_suffix,suffix,solution" ;
    wja:exampleRequest "{\"op\":\"session_repair\",\"handle\":1,\"evals\":100000,\"mem_mb\":256}" .

