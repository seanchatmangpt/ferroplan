# ferroplan-wasm.ttl -- ferroplan's instance of the wasi-json-abi-pack vocabulary.
# Source of ABI truth: crates/ferroplan-wasm/src/wasi_abi.rs (dispatch: 38 ops).
# Drift guard: crates/ferroplan-wasm/tests/abi_ontology_drift.rs compares wja:opName
# against the dispatch arms. Error style is refusal-kind: failures are
# {"error":{"code":"FP_*","message":...,"retryable":false}}; plan_production uses
# the OperationEnvelope. Handle-bearing session ops carry u64 handles (never reused).
# Pin: ferroplan HEAD a03b5cc2eb93 (v0.29.0), `cargo build -p ferroplan-wasm --release
# --target wasm32-wasip1`; matches ex4pm priv/ferroplan/MANIFEST.json bytes.
# Source commit is deliberately absent from the pin: identity, not authority.

@prefix wja: <https://ggen.dev/ontology/wasi-json-abi#> .
@prefix fpw: <http://ferroplan.io/wasm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fpw:module a wja:WasmModule ;
    rdfs:label "ferroplan WASI module" ;
    wja:crateName "ferroplan-wasm" ;
    wja:exportPrefix "fp" ;
    wja:abiVersion 1 ;
    wja:maxRequestBytes 16777216 ;
    wja:maxJsonDepth 128 ;
    wja:stackSizeBytes 16777216 ;
    wja:errorStyle "refusal-kind" ;
    wja:hasAbiVersionExport false ;
    wja:cfgGate "all(target_arch = \"wasm32\", target_os = \"wasi\")" ;
    wja:wasmEnvVar "FERROPLAN_WASM_PATH" ;
    wja:wasmBuildPackage "ferroplan-wasm" ;
    wja:bufferStyle "boxed-slice" ;
    wja:wasmSha256 "088d9c3b0306e36123ddc1ee780ad7e9d4bd2ebb54f9726c43f40a2f6d718233" ;
    wja:wasmBytes 3521589 ;
    fpw:toolchain "stable" ;
    fpw:buildTarget "wasm32-wasip1" ;
    fpw:buildProfile "release" ;
    fpw:exports "memory,fp_alloc,fp_call,fp_dealloc" ;
    wja:importsPolicy "wasi_snapshot_preview1" ;
    wja:hasOp fpw:op-plan , fpw:op-plan-production , fpw:op-htn-plan , fpw:op-fond-policy , fpw:op-fond-policy-validate , fpw:op-fond-validate , fpw:op-hddl-solve , fpw:op-readiness , fpw:op-version , fpw:op-explain , fpw:op-session-new , fpw:op-session-fork , fpw:op-session-free , fpw:op-session-set-goal , fpw:op-session-restrict-prefix-claims , fpw:op-session-restrict-contains , fpw:op-session-think , fpw:op-session-replan-following , fpw:op-session-repair , fpw:op-session-probe , fpw:op-session-valid , fpw:op-session-step , fpw:op-session-suffix , fpw:op-session-advance , fpw:op-session-drop-plan , fpw:op-session-has-plan , fpw:op-session-set-fact , fpw:op-session-set-timed-fact , fpw:op-session-observe , fpw:op-session-goal-met , fpw:op-session-fact , fpw:op-session-apply-start , fpw:op-session-elapse , fpw:op-session-set-fluent , fpw:op-session-fluent , fpw:op-session-plan-valid , fpw:op-session-world-bytes , fpw:op-session-mind-bytes ;
    wja:hasWasiImport fpw:imp-random-get , fpw:imp-environ-get , fpw:imp-environ-sizes-get , fpw:imp-clock-time-get , fpw:imp-fd-close , fpw:imp-fd-fdstat-get , fpw:imp-fd-filestat-get , fpw:imp-fd-prestat-get , fpw:imp-fd-prestat-dir-name , fpw:imp-fd-read , fpw:imp-fd-write , fpw:imp-path-open , fpw:imp-proc-exit , fpw:imp-sched-yield ;
    wja:hasErrorCode fpw:err-fp-adapter , fpw:err-fp-unknown-op , fpw:err-fp-limit-input , fpw:err-fp-invalid-request , fpw:err-fp-invalid-problem , fpw:err-fp-invalid-policy , fpw:err-fp-validation , fpw:err-fp-invariant , fpw:err-fp-limit-search , fpw:err-fp-limit-memory , fpw:err-fp-limit-candidates , fpw:err-fp-limit-candidate , fpw:err-fp-duplicate-candidate , fpw:err-fp-parse , fpw:err-fp-hddl-ground , fpw:err-fp-hddl-translate , fpw:err-fp-hddl-root-mismatch , fpw:err-fp-model , fpw:err-fp-timeout , fpw:err-fp-worker-panicked .

fpw:op-plan a wja:Op ;
    wja:opName "plan" ;
    wja:opOrder 1 ;
    wja:requestFields "op,domain,problem,mode,search,flags" ;
    wja:responseFields "solved,mode,plan,statistics,notes" ;
    wja:exampleRequest "{\"op\":\"plan\",\"domain\":\"(define (domain d) (:requirements :strips) (:predicates (a) (b)) (:action go :parameters () :precondition (a) :effect (and (b) (not (a)))))\",\"problem\":\"(define (problem p) (:domain d) (:init (a)) (:goal (b)))\"}" .

fpw:op-plan-production a wja:Op ;
    wja:opName "plan_production" ;
    wja:opOrder 2 ;
    wja:requestFields "op,domain,problem,mode,search,max_evaluated,max_plan_steps,max_output_bytes,request_id" ;
    wja:responseFields "schema_version,request_id,capability_id,capability_version,build_identity,input_fingerprint,authority,outcome,validation,elapsed_micros,counters,warnings,payload,error" ;
    wja:exampleRequest "{\"op\":\"plan_production\",\"domain\":\"(define (domain d) (:requirements :strips) (:predicates (a) (b)) (:action go :parameters () :precondition (a) :effect (and (b) (not (a)))))\",\"problem\":\"(define (problem p) (:domain d) (:init (a)) (:goal (b)))\",\"mode\":\"auto\",\"request_id\":\"example-1\"}" .

fpw:op-htn-plan a wja:Op ;
    wja:opName "htn_plan" ;
    wja:opOrder 3 ;
    wja:requestFields "op,problem,limits" ;
    wja:responseFields "planning_type,solved,steps,policy,decomposition,notes" ;
    wja:exampleRequest "{\"op\":\"htn_plan\",\"problem\":\"{\\\"tasks\\\":[{\\\"id\\\":\\\"top\\\"},{\\\"id\\\":\\\"p1\\\",\\\"primitive_action\\\":\\\"a1\\\"}],\\\"root_tasks\\\":[\\\"top\\\"],\\\"methods\\\":[{\\\"id\\\":\\\"m-top\\\",\\\"task\\\":\\\"top\\\",\\\"subtasks\\\":[\\\"p1\\\"]}]}\",\"limits\":{\"max_wall_ms\":0}}" .

fpw:op-fond-policy a wja:Op ;
    wja:opName "fond_policy" ;
    wja:opOrder 4 ;
    wja:requestFields "op,problem,limits" ;
    wja:responseFields "planning_type,solved,steps,policy,decomposition,notes,validation" ;
    wja:exampleRequest "{\"op\":\"fond_policy\",\"problem\":\"{\\\"states\\\":[{\\\"id\\\":\\\"s0\\\"},{\\\"id\\\":\\\"g\\\",\\\"facts\\\":[\\\"done\\\"]}],\\\"initial_states\\\":[\\\"s0\\\"],\\\"goal\\\":{\\\"facts\\\":[\\\"done\\\"]},\\\"transitions\\\":[{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"g\\\",\\\"probability_ppm\\\":500000},{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"s0\\\",\\\"probability_ppm\\\":500000}]}\",\"limits\":{\"max_wall_ms\":0}}" .

fpw:op-fond-policy-validate a wja:Op ;
    wja:opName "fond_policy_validate" ;
    wja:opOrder 5 ;
    wja:requestFields "op,problem,plan" ;
    wja:responseFields "valid,guarantee,reachable_states,reachable_goals,issues" ;
    wja:exampleRequest "{\"op\":\"fond_policy_validate\",\"problem\":\"{\\\"states\\\":[{\\\"id\\\":\\\"s0\\\"},{\\\"id\\\":\\\"g\\\",\\\"facts\\\":[\\\"done\\\"]}],\\\"initial_states\\\":[\\\"s0\\\"],\\\"goal\\\":{\\\"facts\\\":[\\\"done\\\"]},\\\"transitions\\\":[{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"g\\\",\\\"probability_ppm\\\":500000},{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"s0\\\",\\\"probability_ppm\\\":500000}]}\",\"plan\":{\"planning_type\":\"fond\",\"solved\":true,\"steps\":[],\"policy\":[{\"state\":\"s0\",\"action\":\"flip\",\"outcomes\":[{\"state\":\"g\",\"probability_ppm\":500000},{\"state\":\"s0\",\"probability_ppm\":500000}]}],\"decomposition\":[],\"notes\":[]}}" .

fpw:op-fond-validate a wja:Op ;
    wja:opName "fond_validate" ;
    wja:opOrder 6 ;
    wja:requestFields "op,problem,plan" ;
    wja:responseFields "valid,guarantee,reachable_states,reachable_goals,issues" ;
    wja:exampleRequest "{\"op\":\"fond_validate\",\"problem\":\"{\\\"states\\\":[{\\\"id\\\":\\\"s0\\\"},{\\\"id\\\":\\\"g\\\",\\\"facts\\\":[\\\"done\\\"]}],\\\"initial_states\\\":[\\\"s0\\\"],\\\"goal\\\":{\\\"facts\\\":[\\\"done\\\"]},\\\"transitions\\\":[{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"g\\\",\\\"probability_ppm\\\":500000},{\\\"action\\\":\\\"flip\\\",\\\"from\\\":\\\"s0\\\",\\\"to\\\":\\\"s0\\\",\\\"probability_ppm\\\":500000}]}\",\"plan\":{\"planning_type\":\"fond\",\"solved\":true,\"steps\":[],\"policy\":[{\"state\":\"s0\",\"action\":\"flip\",\"outcomes\":[{\"state\":\"g\",\"probability_ppm\":500000},{\"state\":\"s0\",\"probability_ppm\":500000}]}],\"decomposition\":[],\"notes\":[]}}" .

fpw:op-hddl-solve a wja:Op ;
    wja:opName "hddl_solve" ;
    wja:opOrder 7 ;
    wja:requestFields "op,domain,problem,limits" ;
    wja:responseFields "planning_type,solved,steps,policy,decomposition,notes" ;
    wja:exampleRequest "{\"op\":\"hddl_solve\",\"domain\":\"(define (domain transport-oneof) (:types loc) (:predicates (at ?l - loc)(connected ?a - loc ?b - loc)(has-package)(delivered)) (:task deliver :parameters (?from - loc ?to - loc)) (:action pickup :parameters (?l - loc) :precondition (at ?l) :effect (has-package)) (:action drive :parameters (?a - loc ?b - loc) :precondition (and (at ?a)(connected ?a ?b)) :effect (oneof (and (not (at ?a))(at ?b)) (and))) (:action dropoff :parameters () :precondition (has-package) :effect (delivered)) (:method m-deliver :parameters (?from ?to) :task (deliver ?from ?to) :ordered-subtasks (and (t1 (pickup ?from))(t2 (drive ?from ?to))(t3 (dropoff)))))\",\"problem\":\"(define (problem transport-oneof-p1)(:domain transport-oneof)(:objects l1 l2 - loc)(:htn :parameters () :ordered-subtasks (and (m1 (deliver l1 l2))))(:init (at l1)(connected l1 l2))(:goal (and (delivered))))\",\"limits\":{\"max_wall_ms\":0}}" .

fpw:op-readiness a wja:Op ;
    wja:opName "readiness" ;
    wja:opOrder 8 ;
    wja:requestFields "op" ;
    wja:responseFields "schema_version,product_version,manifest_fingerprint,contract_valid,admission_state,admission_notice,manifest" ;
    wja:exampleRequest "{\"op\":\"readiness\"}" .

fpw:op-version a wja:Op ;
    wja:opName "version" ;
    wja:opOrder 9 ;
    wja:requestFields "op" ;
    wja:responseFields "version" ;
    wja:exampleRequest "{\"op\":\"version\"}" .

fpw:op-explain a wja:Op ;
    wja:opName "explain" ;
    wja:opOrder 10 ;
    wja:requestFields "op,domain,problem,plan" ;
    wja:responseFields "kind,causal_links,invariant_spans,preferences" ;
    wja:exampleRequest "{\"op\":\"explain\",\"domain\":\"(define (domain d) (:requirements :strips) (:predicates (a) (b)) (:action go :parameters () :precondition (a) :effect (and (b) (not (a)))))\",\"problem\":\"(define (problem p) (:domain d) (:init (a)) (:goal (b)))\",\"plan\":{\"steps\":[{\"index\":0,\"action\":\"go\",\"args\":[]}],\"length\":1}}" .

fpw:op-session-new a wja:Op ;
    wja:opName "session_new" ;
    wja:opOrder 11 ;
    wja:requestFields "op,domain,problem" ;
    wja:responseFields "handle" ;
    wja:exampleRequest "{\"op\":\"session_new\",\"domain\":\"(define (domain d) (:requirements :strips) (:predicates (a) (b)) (:action go :parameters () :precondition (a) :effect (and (b) (not (a)))))\",\"problem\":\"(define (problem p) (:domain d) (:init (a)) (:goal (b)))\"}" .

fpw:op-session-fork a wja:Op ;
    wja:opName "session_fork" ;
    wja:opOrder 12 ;
    wja:requestFields "op,handle,keep_plan" ;
    wja:responseFields "handle" ;
    wja:exampleRequest "{\"op\":\"session_fork\",\"handle\":1,\"keep_plan\":false}" .

fpw:op-session-free a wja:Op ;
    wja:opName "session_free" ;
    wja:opOrder 13 ;
    wja:requestFields "op,handle" ;
    wja:responseFields "freed" ;
    wja:exampleRequest "{\"op\":\"session_free\",\"handle\":1}" .

fpw:op-session-set-goal a wja:Op ;
    wja:opName "session_set_goal" ;
    wja:opOrder 14 ;
    wja:requestFields "op,handle,goal" ;
    wja:responseFields "ok" ;
    wja:exampleRequest "{\"op\":\"session_set_goal\",\"handle\":1,\"goal\":\"(b)\"}" .

fpw:op-session-restrict-prefix-claims a wja:Op ;
    wja:opName "session_restrict_prefix_claims" ;
    wja:opOrder 15 ;
    wja:requestFields "op,handle,prefix,claimed" ;
    wja:responseFields "ok" ;
    wja:exampleRequest "{\"op\":\"session_restrict_prefix_claims\",\"handle\":1,\"prefix\":\"(go\",\"claimed\":\"A,B\"}" .

fpw:op-session-restrict-contains a wja:Op ;
    wja:opName "session_restrict_contains" ;
    wja:opOrder 16 ;
    wja:requestFields "op,handle,filter" ;
    wja:responseFields "ok" ;
    wja:exampleRequest "{\"op\":\"session_restrict_contains\",\"handle\":1,\"filter\":\"go\"}" .

fpw:op-session-think a wja:Op ;
    wja:opName "session_think" ;
    wja:opOrder 17 ;
    wja:requestFields "op,handle,evals,mem_mb,prefer_follow" ;
    wja:responseFields "solved,mode,plan,statistics,notes,verdict,capped,spent_evals" ;
    wja:exampleRequest "{\"op\":\"session_think\",\"handle\":1,\"evals\":100000,\"mem_mb\":256}" .

